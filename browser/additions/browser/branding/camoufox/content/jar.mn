# Any page can load chrome://branding/content/ (contentaccessible=yes), so it
# ships Firefox's official files byte for byte. Camoufox's own branding stays in
# the OS-level icons and names, which pages cannot see.
browser.jar:
% content branding %content/branding/ contentaccessible=yes
  content/branding/about.png                     (../../official/content/about.png)
  content/branding/about-logo.png                (../../official/content/about-logo.png)
  content/branding/about-logo.svg                (../../official/content/about-logo.svg)
  content/branding/about-logo@2x.png             (../../official/content/about-logo@2x.png)
  content/branding/about-logo-private.png        (../../official/content/about-logo-private.png)
  content/branding/about-logo-private@2x.png     (../../official/content/about-logo-private@2x.png)
  content/branding/about-wordmark.svg            (../../official/content/about-wordmark.svg)
  content/branding/document.ico                  (../../official/document.ico)
  content/branding/document_pdf.svg              (../../official/content/document_pdf.svg)
  content/branding/firefox-wordmark.svg          (../../official/content/firefox-wordmark.svg)
  content/branding/icon16.png                    (../../official/default16.png)
  content/branding/icon32.png                    (../../official/default32.png)
  content/branding/icon48.png                    (../../official/default48.png)
  content/branding/icon64.png                    (../../official/default64.png)
  content/branding/icon128.png                   (../../official/default128.png)
  content/branding/aboutDialog.css               (../../official/content/aboutDialog.css)
