   auto pipeID = std::to_string(pfd[1]);
+  // Headless on a display (Xvfb, a virtual GPU) probes that display, as stock
+  // does. Only a display-less headless launch has no server to ask, so it
+  // probes Mesa's software GL through EGL, which needs no display.
+  const bool headlessSoftware = PR_GetEnv("MOZ_HEADLESS") &&
+                                !PR_GetEnv("DISPLAY") &&
+                                !PR_GetEnv("WAYLAND_DISPLAY");
   const char* args[] = {"glx", "-f", pipeID.c_str(),
-                        IsWaylandEnabled() ? "-w" : nullptr, nullptr};
+                        headlessSoftware       ? "-e"
+                        : IsWaylandEnabled() ? "-w"
+                                             : nullptr,
+                        nullptr};
   sGLXTestPID = FireTestProcess(GFX_PROBE_BINARY, nullptr, args);
   // Set pid to -1 to avoid further test launch.
   if (!sGLXTestPID) {
@@ -1594,6 +1603,19 @@ nsresult GfxInfo::GetFeatureStatusImpl(
     return NS_OK;
   }
 
+  // Camoufox: a display-less headless launch's WebGL is Mesa's software EGL
+  // device, the llvmpipe a headed browser on Xvfb gets. Without this, EGL
+  // picks the first device it enumerates (a real GPU, NVIDIA's on a mixed
