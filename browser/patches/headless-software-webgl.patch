   // Get a list of all GPUs from the PCI bus.
   get_pci_status();
 
+  // Claim EGL only when this probe initialized it. Recording TEST_TYPE EGL
+  // after a failed load makes Firefox use EGL anyway, and WebGL then dies in
+  // FEATURE_FAILURE_EGL_LOAD_3 instead of using the display's GLX.
+  bool headlessEgl = false;
