@@ -4959,6 +4959,22 @@ bool PeerConnectionImpl::ShouldForceProxy() const {
   // Ok, we're supposed to be proxy_only, but only if a proxy is configured.
   // Let's just see if the document was loaded via a proxy.
 
+  // Camoufox: the launcher sets a per-context flag when that context has a
+  // proxy, and a launch-level one for the browser's own. A document with no
+  // HTTP channel (about:blank, srcdoc, blob:, data:) cannot answer for
+  // itself, and Juggler's per-context proxies are not in network.proxy.*.
+  // Unset leaves the document chain and the launch-level prefs to decide, so
+  // a direct launch stays direct.
+  const uint32_t userContextId =
+      mWindow ? dom::RoverfoxStorageManager::UserContextId(mWindow.get()) : 0;
+  bool proxied = false;
+  if (WebRTCIPManager::GetProxied(userContextId, proxied)) {
+    return proxied;
+  }
+  if (MaskConfig::GetBool("webrtc:proxied")) {
+    return true;
+  }
+
