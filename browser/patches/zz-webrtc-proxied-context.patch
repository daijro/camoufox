+/* static */ bool
+WebRTCIPManager::IsProxied(uint32_t userContextId) {
+  nsString key;
+  key.AppendLiteral(u"webrtc_proxied_");
+  key.AppendInt(userContextId);
+  bool proxied = false;
+  return (RoverfoxStorageManager::GetBool(key, proxied) && proxied) ||
+         (RoverfoxStorageManager::GetBool(u"webrtc_proxied_browser"_ns,
+                                          proxied) &&
+          proxied);
+}
