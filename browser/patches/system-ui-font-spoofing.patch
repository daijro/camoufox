+// Camoufox: the OS whose system-ui family a lookup resolves to: the one the
+// document's context presents, or None to resolve it as the host does. Chrome
+// documents are not reachable by the page and keep the host's: pointing the
+// browser's own UI at a family from another OS leaves it falling back to the
+// default serif font (daijro/camoufox#695). So does a native identity: on macOS
+// the real system font is -apple-system (SF Pro), which Helvetica does not
+// match (measured 2026-09-14: ascent 16 vs 13, 537.6 vs 526.6 px).
+static MaskConfig::SpoofedOS SystemUISpoofedOS(
+    FontVisibilityProvider* aFontVisibilityProvider) {
+  using MaskConfig::SpoofedOS;
+  if (aFontVisibilityProvider && aFontVisibilityProvider->IsChrome()) {
+    return SpoofedOS::None;
+  }
+  const mozilla::dom::Document* doc =
+      aFontVisibilityProvider ? aFontVisibilityProvider->GetDocument()
+                              : nullptr;
+  const auto os = mozilla::dom::NavigatorManager::GetSpoofedOS(
+      mozilla::dom::RoverfoxStorageManager::UserContextId(doc));
+  switch (os) {
+#ifndef XP_MACOSX
+    case SpoofedOS::MacOS:
+#endif
+#ifndef XP_WIN
+    case SpoofedOS::Windows:
+#endif
+    case SpoofedOS::Linux:
+      return os;
+    default:
+      return SpoofedOS::None;
+  }
+}
+
 static void GetSystemUIFontFamilies(
     FontVisibilityProvider* aFontVisibilityProvider,
     [[maybe_unused]] nsAtom* aLangGroup, nsTArray<nsCString>& aFamilies) {
+  switch (SystemUISpoofedOS(aFontVisibilityProvider)) {
+    case MaskConfig::SpoofedOS::MacOS:
+      *aFamilies.AppendElement() = "Helvetica"_ns;
+      return;
+    case MaskConfig::SpoofedOS::Windows:
+      *aFamilies.AppendElement() = "Segoe UI"_ns;
+      return;
+    case MaskConfig::SpoofedOS::Linux:
+      // The GTK interface font of a stock Ubuntu desktop; see
+      // font-system-fonts-css2.patch for the CSS2 keywords.
+      *aFamilies.AppendElement() = "Ubuntu"_ns;
+      return;
+    default:
+      break;
+  }
+
