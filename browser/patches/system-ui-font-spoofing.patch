diff --git a/gfx/thebes/gfxPlatformFontList.cpp b/gfx/thebes/gfxPlatformFontList.cpp
index 42b2b42650..4955943e4a 100644
--- a/gfx/thebes/gfxPlatformFontList.cpp
+++ b/gfx/thebes/gfxPlatformFontList.cpp
@@ -2301,6 +2301,36 @@ void gfxPlatformFontList::MaybeRemoveCmap(gfxCharacterMap* aCharMap,
 static void GetSystemUIFontFamilies(
     FontVisibilityProvider* aFontVisibilityProvider,
     [[maybe_unused]] nsAtom* aLangGroup, nsTArray<nsCString>& aFamilies) {
+  // Camoufox: spoof system-ui to match the spoofed OS. Chrome documents are
+  // excluded: they are not reachable by the page, and pointing the browser's
+  // own UI at a family from another OS leaves it falling back to the default
+  // serif font (daijro/camoufox#695). A null provider means there is no
+  // document behind the lookup, where spoofing is the safe default.
+  if (!(aFontVisibilityProvider && aFontVisibilityProvider->IsChrome())) {
+    const auto os = MaskConfig::GetSpoofedOS();
+    // A native identity (the host's own OS) keeps the real system font: on
+    // macOS that is -apple-system (SF Pro), which Helvetica does not match
+    // (measured 2026-09-14: ascent 16 vs 13, 537.6 vs 526.6 px).
+#ifndef XP_MACOSX
+    if (os == MaskConfig::SpoofedOS::MacOS) {
+      *aFamilies.AppendElement() = "Helvetica"_ns;
+      return;
+    }
+#endif
+#ifndef XP_WIN
+    if (os == MaskConfig::SpoofedOS::Windows) {
+      *aFamilies.AppendElement() = "Segoe UI"_ns;
+      return;
+    }
+#endif
+    if (os == MaskConfig::SpoofedOS::Linux) {
+      // The GTK interface font of a stock Ubuntu desktop; see
+      // font-system-fonts-css2.patch for the CSS2 keywords.
+      *aFamilies.AppendElement() = "Ubuntu"_ns;
+      return;
+    }
+  }
+
   // TODO: On macOS, use CTCreateUIFontForLanguage or such thing (though the
   // code below ends up using [NSFont systemFontOfSize: 0.0].
   nsFont systemFont;
