+// Camoufox: see RecvRealMouseMoveEvent.
+static void JugglerNotifyMouseMoveArrived(const WidgetMouseEvent& aEvent) {
+  if (!aEvent.mJugglerEventId) {
+    return;
+  }
+  if (nsCOMPtr<nsIObserverService> observerService =
+          mozilla::services::GetObserverService()) {
+    observerService->NotifyObservers(
+        nullptr, "juggler-mouse-event-hit-renderer",
+        NS_ConvertASCIItoUTF16(
+            nsPrintfCString("mousequeued %" PRIu32, aEvent.mJugglerEventId))
+            .get());
+  }
+}
