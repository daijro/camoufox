index 0000000000..c5f3dd4247
--- /dev/null
+++ b/dom/base/RoverfoxStorageManager.cpp
@@ -0,0 +1,450 @@
+#include "RoverfoxStorageManager.h"
+#include "mozilla/Preferences.h"
+#include "nsIPrefBranch.h"
+#include "nsXULAppAPI.h"
+#include "mozilla/dom/ContentChild.h"
+#include "nsThreadUtils.h"
+#include "jsapi.h"
+#include "js/PropertyAndElement.h"
+#include "mozilla/dom/Document.h"
+#include "nsIPrincipal.h"
+#include "nsContentUtils.h"
+#include "nsGlobalWindowInner.h"
+#include "xpcpublic.h"
+
+#include <atomic>
+#include <cstdint>
+
+namespace mozilla {
+namespace dom {
+
+// Values live on the DEFAULT pref branch. They are session state (per-context
+// values a launch sets up), and default prefs are never written to prefs.js:
+// as user prefs a persistent profile kept them, so a relaunch with a different
+// config still reported the previous session's timezone and navigator values.
+// Reading the default branch alone also ignores user values an older build
+// left in a profile's prefs.js.
+static constexpr auto kKind = PrefValueKind::Default;
+
+/* static */ nsTHashMap<nsCStringHashKey, nsCString>&
+RoverfoxStorageManager::GetLocalCache() {
+  static nsTHashMap<nsCStringHashKey, nsCString> sCache;
+  return sCache;
+}
+
+/* static */ mozilla::Mutex&
+RoverfoxStorageManager::GetLocalCacheMutex() {
+  static mozilla::Mutex sMutex("RoverfoxStorageCache");
+  return sMutex;
+}
+
+/* static */ nsCString
+RoverfoxStorageManager::MakePrefName(const nsAString& key) {
+  nsAutoCString prefName("roverfox.s.");
+  AppendUTF16toUTF8(key, prefName);
+  return nsCString(prefName);
+}
+
+// Bumped after every change to what ReadValue can answer: a put, a mirrored
+// pref, the mirror's snapshot. A memo taken
+// under an older generation is read again. Starts at 1 so a zeroed slot never
+// matches.
+static std::atomic<uint64_t> sGeneration{1};
+
+/* static */ void RoverfoxStorageManager::BumpGeneration() {
+  sGeneration.fetch_add(1, std::memory_order_release);
+}
+
+// Per-context getters are page-callable in a loop, and each read built its
+// key with AppendPrintf, converted it to UTF-8 and took the cache lock (plus
+// a pref lookup on a main-thread miss). Measured from script against stock
+// Firefox 152.0.4: navigator.hardwareConcurrency 380-680 ns vs 45 ns,
+// screen.width 820-940 ns vs 130 ns -- a gap a page can time. A hit here is
+// one generation check.
+//
+// A memo never answers for another context or for a stale value:
+// - A slot matches only its own (aPrefix, aId), and the userContextId is part
+//   of that key, so one context's value cannot answer another's read.
+// - Every change to what ReadValue reads (the local cache and the prefs behind
+//   the mirror) bumps sGeneration after the change is made, and
+//   a reader loads the generation before it looks the value up. A slot taken
+//   under generation G is a hit only while the generation is still G, so a
+//   write that lands before, during or after the lookup leaves the slot stale
+//   and the next read looks again.
+// - The memo is per thread, so no slot is shared between threads, and a
+//   worker's slot is invalidated by the same bump as the main thread's.
+struct RoverfoxStorageManager::MemoSlot {
+  const char* prefix;
+  uint32_t id;
+  uint64_t generation;
+  bool present;
+  bool isUint;
+  uint32_t uintValue;
+  bool boolValue;
+};
+
+static constexpr size_t kMemoSlots = 256;
+// Slots probed per key. With one, two keys read alternately (screen width
+// and height, whose prefix literals sit bytes apart) could share a slot and
+// evict each other on every read: per-context screen.width stayed at ~600 ns.
+static constexpr size_t kMemoWays = 4;
+
+static size_t MemoIndex(const char* aPrefix, uint32_t aId) {
+  uint64_t h = static_cast<uint64_t>(reinterpret_cast<uintptr_t>(aPrefix)) *
+                   0x9E3779B97F4A7C15ULL ^
+               static_cast<uint64_t>(aId) * 0xC2B2AE3D27D4EB4FULL;
+  return static_cast<size_t>(h >> 40);
+}
+
+// The slot holding (aPrefix, aId) in this thread's memo. aHit is true when it
+// was filled under aGeneration; otherwise the slot is the one to refill.
+template <typename Slot>
+static Slot& FindMemoSlot(Slot (&aMemo)[kMemoSlots], uint32_t& aNextVictim,
+                          const char* aPrefix, uint32_t aId,
+                          uint64_t aGeneration, bool& aHit) {
+  aHit = false;
+  size_t base = MemoIndex(aPrefix, aId);
+  Slot* victim = nullptr;
+  for (size_t way = 0; way < kMemoWays; ++way) {
+    Slot& candidate = aMemo[(base + way) & (kMemoSlots - 1)];
+    if (candidate.prefix == aPrefix && candidate.id == aId) {
+      aHit = candidate.generation == aGeneration;
+      return candidate;
+    }
+    if (!victim && candidate.generation != aGeneration) {
+      victim = &candidate;
+    }
+  }
+  if (!victim) {
+    victim = &aMemo[(base + aNextVictim++ % kMemoWays) & (kMemoSlots - 1)];
+  }
+  return *victim;
+}
+
+static nsString MemoKey(const char* aPrefix, uint32_t aId) {
+  nsAutoString key;
+  key.AssignASCII(aPrefix);
+  key.AppendInt(aId);
+  return nsString(key);
+}
+
+/* static */ RoverfoxStorageManager::MemoSlot
+RoverfoxStorageManager::ReadMemoized(const char* aPrefix, uint32_t aId) {
+  // Zero-initialized per thread: generation 0 never matches sGeneration.
+  static thread_local MemoSlot tMemo[kMemoSlots];
+  static thread_local uint32_t tNextVictim;
+  uint64_t generation = sGeneration.load(std::memory_order_acquire);
+  bool hit;
+  MemoSlot& slot =
+      FindMemoSlot(tMemo, tNextVictim, aPrefix, aId, generation, hit);
+  if (hit) {
+    return slot;
+  }
+
+  nsAutoCString value;
+  ReadValue(MakePrefName(MemoKey(aPrefix, aId)), value);
+
+  slot.prefix = aPrefix;
+  slot.id = aId;
+  // The generation read before the lookup: a write racing it leaves this
+  // slot stale by one generation, so the next read looks again.
+  slot.generation = generation;
+  slot.present = !value.IsEmpty();
+  nsresult parseRv;
+  int64_t parsed = value.ToInteger64(&parseRv);
+  slot.isUint = slot.present && NS_SUCCEEDED(parseRv) && parsed >= 0;
+  slot.uintValue = slot.isUint ? static_cast<uint32_t>(parsed) : 0;
+  slot.boolValue = value.EqualsLiteral("1");
+  return slot;
+}
+
+/* static */ bool RoverfoxStorageManager::GetUint(const char* aPrefix,
+                                                  uint32_t aId,
+                                                  uint32_t& outValue) {
+  MemoSlot slot = ReadMemoized(aPrefix, aId);
+  if (!slot.isUint) {
+    return false;
+  }
+  outValue = slot.uintValue;
+  return true;
+}
+
+/* static */ bool RoverfoxStorageManager::GetBool(const char* aPrefix,
+                                                  uint32_t aId,
+                                                  bool& outValue) {
+  MemoSlot slot = ReadMemoized(aPrefix, aId);
+  if (!slot.present) {
+    return false;
+  }
+  outValue = slot.boolValue;
+  return true;
+}
+
+// String getters (navigator.platform/userAgent, the timezone, WebGL vendor)
+// get the same memo: each read built a key, took the cache lock and copied the
+// value, and workers reading them in a loop held that lock -- an adaptive
+// pthread mutex, which does not queue waiters -- against the main thread
+// mirroring new contexts' prefs. A hit takes no lock and copies no characters.
+struct StringMemoSlot {
+  const char* prefix = nullptr;
+  uint32_t id = 0;
+  uint64_t generation = 0;
+  bool present = false;
+  // Shares the buffer it was converted into, so a hit copies no characters.
+  nsString value;
+};
+
+/* static */ bool RoverfoxStorageManager::GetString(const char* aPrefix,
+                                                    uint32_t aId,
+                                                    nsAString& outValue) {
+  static thread_local StringMemoSlot tMemo[kMemoSlots];
+  static thread_local uint32_t tNextVictim;
+  uint64_t generation = sGeneration.load(std::memory_order_acquire);
+  bool hit;
+  StringMemoSlot& slot =
+      FindMemoSlot(tMemo, tNextVictim, aPrefix, aId, generation, hit);
+  if (!hit) {
+    nsAutoCString value;
+    ReadValue(MakePrefName(MemoKey(aPrefix, aId)), value);
+
+    slot.prefix = aPrefix;
+    slot.id = aId;
+    // As in ReadMemoized: the generation read before the lookup.
+    slot.generation = generation;
+    slot.present = !value.IsEmpty();
+    CopyUTF8toUTF16(value, slot.value);
+  }
+  if (!slot.present) {
+    return false;
+  }
+  outValue = slot.value;
+  return true;
+}
+
+static void OnStoragePrefChanged(const char* aPrefName, void*) {
+  RoverfoxStorageManager::MirrorPref(nsDependentCString(aPrefName));
+}
+
+/* static */ void RoverfoxStorageManager::MirrorPref(const nsACString& aPrefName) {
+  MOZ_ASSERT(NS_IsMainThread());
+  nsAutoCString value;
+  Preferences::GetCString(PromiseFlatCString(aPrefName).get(), value, kKind);
+  {
+    MutexAutoLock lock(GetLocalCacheMutex());
+    if (value.IsEmpty()) {
+      GetLocalCache().Remove(aPrefName);
+    } else {
+      GetLocalCache().InsertOrUpdate(aPrefName, value);
+    }
+  }
+  BumpGeneration();
+}
+
+// libpref's table is main-thread only: a release build looks it up without a
+// lock, so a worker reading it while the main thread inserted a pref (another
+// context putting its values) crashed the content process -- measured within
+// seconds with workers reading navigator while contexts were created. Workers
+// read the local cache alone, and the main thread keeps that cache a mirror of
+// every roverfox.s.* pref: a snapshot the first time this process uses the
+// storage on the main thread, then the prefix callback. A value already cached
+// locally wins over the snapshot, as it does in ReadValue.
+/* static */ void RoverfoxStorageManager::EnsureMirror() {
+  static bool sMirrored = false;
+  if (sMirrored || !NS_IsMainThread()) {
+    return;
+  }
+  sMirrored = true;
+  Preferences::RegisterPrefixCallback(OnStoragePrefChanged, "roverfox.s."_ns);
+
+  nsTArray<nsCString> names;
+  nsIPrefBranch* root = Preferences::GetRootBranch(kKind);
+  if (!root || NS_FAILED(root->GetChildList("roverfox.s.", names))) {
+    return;
+  }
+  for (const nsCString& name : names) {
+    nsAutoCString value;
+    Preferences::GetCString(name.get(), value, kKind);
+    if (value.IsEmpty()) {
+      continue;
+    }
+    MutexAutoLock lock(GetLocalCacheMutex());
+    if (!GetLocalCache().Contains(name)) {
+      GetLocalCache().InsertOrUpdate(name, nsCString(value));
+    }
+  }
+  BumpGeneration();
+}
+
+/* static */ void
+RoverfoxStorageManager::SetPrefValue(const nsCString& prefName,
+                                      const nsCString& value) {
+  EnsureMirror();
+  // Always store locally for immediate reads in this process
+  {
+    MutexAutoLock lock(GetLocalCacheMutex());
+    GetLocalCache().InsertOrUpdate(prefName, nsCString(value));
+  }
+  BumpGeneration();
+  // Sync to parent for cross-process availability. Only from the main thread:
+  // libpref is main-thread only, and a PContent send from any other thread
+  // hits MessageChannel's release assert and kills the content process. Every
+  // put today comes from a window's setter, but a put from a worker (as the
+  // timezone's CAMOU_CONFIG fallback once made) would crash rather than
+  // fail. The local write above already answers that thread.
+  if (!NS_IsMainThread()) {
+    NS_DispatchToMainThread(NS_NewRunnableFunction(
+        "RoverfoxStorageManager::SyncToParent",
+        [prefName = nsCString(prefName), value = nsCString(value)]() {
+          SyncToParent(prefName, value);
+        }));
+    return;
+  }
+  SyncToParent(prefName, value);
+}
+
+/* static */ void RoverfoxStorageManager::SyncToParent(const nsCString& prefName,
+                                                       const nsCString& value) {
+  MOZ_ASSERT(NS_IsMainThread());
+  if (XRE_IsParentProcess()) {
+    Preferences::SetCString(prefName.get(), value, kKind);
+  } else {
+    ContentChild* cc = ContentChild::GetSingleton();
+    if (cc) {
+      cc->SendRoverfoxStoragePut(prefName, value);
+    }
+  }
+}
+
+/* static */ void RoverfoxStorageManager::ReadValue(const nsCString& prefName,
+                                                    nsACString& outValue) {
+  EnsureMirror();
+  // Local cache first (values set in this process, and the pref mirror)
+  {
+    MutexAutoLock lock(GetLocalCacheMutex());
+    if (auto entry = GetLocalCache().Lookup(prefName)) {
+      outValue = entry.Data();
+    }
+  }
+  // Off the main thread the mirror is the whole answer (see EnsureMirror).
+  if (!outValue.IsEmpty() || !NS_IsMainThread()) {
+    return;
+  }
+  // Then Preferences (values synced from other processes)
+  Preferences::GetCString(prefName.get(), outValue, kKind);
+  // No sync IPC to the parent for a key this process has not seen. It made
+  // the first read of each unset key in a process cost 16-54 ms (stock: under
+  // 1 ms), which a page can time on its first navigator.hardwareConcurrency
+  // or screen.width. A put reaches the parent synchronously, and the parent's
+  // pref update to this process is queued on PContent before any later
+  // message to it, so a document this process starts loading after the put
+  // already finds the value in its prefs.
+}
+
+/* static */ void
+RoverfoxStorageManager::PutUint(const nsAString& key, uint32_t value) {
+  nsCString prefName = MakePrefName(key);
+  nsAutoCString strValue;
+  strValue.AppendInt(static_cast<int64_t>(value));
+  SetPrefValue(prefName, strValue);
+}
+
+/* static */ bool
+RoverfoxStorageManager::GetUint(const nsAString& key, uint32_t& outValue) {
+  nsAutoCString strValue;
+  ReadValue(MakePrefName(key), strValue);
+  if (!strValue.IsEmpty()) {
+    nsresult parseRv;
+    int64_t parsed = strValue.ToInteger64(&parseRv);
+    if (NS_SUCCEEDED(parseRv) && parsed >= 0) {
+      outValue = static_cast<uint32_t>(parsed);
+      return true;
+    }
+  }
+  return false;
+}
+
+/* static */ void
+RoverfoxStorageManager::PutBool(const nsAString& key, bool value) {
+  nsCString prefName = MakePrefName(key);
+  nsAutoCString strValue(value ? "1" : "0");
+  SetPrefValue(prefName, strValue);
+}
+
+/* static */ bool
+RoverfoxStorageManager::GetBool(const nsAString& key, bool& outValue) {
+  nsAutoCString strValue;
+  ReadValue(MakePrefName(key), strValue);
+  if (!strValue.IsEmpty()) {
+    outValue = strValue.EqualsLiteral("1");
+    return true;
+  }
+  return false;
+}
+
+/* static */ void
+RoverfoxStorageManager::PutString(const nsAString& key,
+                                   const nsAString& value) {
+  nsCString prefName = MakePrefName(key);
+  nsAutoCString utf8Value;
+  CopyUTF16toUTF8(value, utf8Value);
+  SetPrefValue(prefName, utf8Value);
+}
+
+/* static */ bool
+RoverfoxStorageManager::GetString(const nsAString& key, nsAString& outValue) {
+  nsAutoCString utf8Value;
+  ReadValue(MakePrefName(key), utf8Value);
+  if (!utf8Value.IsEmpty()) {
+    CopyUTF8toUTF16(utf8Value, outValue);
+    return true;
+  }
+  return false;
+}
+
+/* static */ uint32_t RoverfoxStorageManager::UserContextId(
+    nsIPrincipal* aPrincipal) {
+  return aPrincipal ? aPrincipal->OriginAttributesRef().mUserContextId : 0;
+}
+
+/* static */ uint32_t RoverfoxStorageManager::UserContextId(
+    const nsINode* aNode) {
+  return aNode ? UserContextId(aNode->NodePrincipal()) : 0;
+}
+
+/* static */ uint32_t RoverfoxStorageManager::UserContextId(
+    nsPIDOMWindowInner* aWindow) {
+  return aWindow ? UserContextId(aWindow->GetExtantDoc()) : 0;
+}
+
+static nsString SetterUsedKey(const char* aName, uint32_t aUserContextId) {
+  nsString key;
+  key.AppendPrintf("%s_d_%u", aName, aUserContextId);
+  return key;
+}
+
+/* static */ void RoverfoxStorageManager::MarkSetterUsed(
+    const char* aName, uint32_t aUserContextId) {
+  PutBool(SetterUsedKey(aName, aUserContextId), true);
+}
+
+/* static */ bool RoverfoxStorageManager::IsSetterOffered(JSObject* aObj,
+                                                          const char* aName) {
+  nsGlobalWindowInner* win = xpc::WindowOrNull(aObj);
+  if (!win) return false;
+  bool used = false;
+  GetBool(SetterUsedKey(aName, UserContextId(win)), used);
+  return !used;
+}
+
+/* static */ void RoverfoxStorageManager::RemoveSetter(const char* aName) {
+  JSContext* cx = nsContentUtils::GetCurrentJSContext();
+  if (!cx) return;
+  JS::Rooted<JSObject*> global(cx, JS::CurrentGlobalOrNull(cx));
+  if (!global) return;
+  JS::Rooted<JS::Value> undef(cx, JS::UndefinedValue());
+  JS_SetProperty(cx, global, aName, undef);
+  JS_DeleteProperty(cx, global, aName);
+}
+
+}  // namespace dom
+}  // namespace mozilla
diff --git a/dom/base/RoverfoxStorageManager.h b/dom/base/RoverfoxStorageManager.h
new file mode 100644
index 0000000000..c7dad0158f
--- /dev/null
+++ b/dom/base/RoverfoxStorageManager.h
@@ -0,0 +1,75 @@
+#ifndef mozilla_dom_RoverfoxStorageManager_h
+#define mozilla_dom_RoverfoxStorageManager_h
+
+#include "nsString.h"
+#include "nsTHashMap.h"
+#include "nsTHashSet.h"
+#include "nsHashKeys.h"
+#include "mozilla/Mutex.h"
+
+class JSObject;
+class nsINode;
+class nsIPrincipal;
+class nsPIDOMWindowInner;
+
+namespace mozilla {
+namespace dom {
+
+// Cross-process key-value storage using Firefox Preferences + local cache.
+// Write-through: values stored locally (immediate reads) and sent to parent
+// process via IPDL (cross-process sync via Preferences API).
+// Keys prefixed with "roverfox.s." to avoid conflicts.
+class RoverfoxStorageManager {
+ public:
+  static void PutUint(const nsAString& key, uint32_t value);
+  static bool GetUint(const nsAString& key, uint32_t& outValue);
+  static void PutBool(const nsAString& key, bool value);
+  static bool GetBool(const nsAString& key, bool& outValue);
+  static void PutString(const nsAString& key, const nsAString& value);
+  static bool GetString(const nsAString& key, nsAString& outValue);
+  // The same reads for the value stored under aPrefix followed by aId
+  // ("nav_hwc_", 3 -> "nav_hwc_3"), for getters a page can call in a loop.
+  // Each thread memoizes the answer until any write in this process, so a
+  // repeat read builds no key and takes no lock. aPrefix must be a string
+  // literal: its address is part of the memo key.
+  static bool GetUint(const char* aPrefix, uint32_t aId, uint32_t& outValue);
+  static bool GetBool(const char* aPrefix, uint32_t aId, bool& outValue);
+  static bool GetString(const char* aPrefix, uint32_t aId, nsAString& outValue);
+  // A put reached this process's prefs: copy it into the local cache (main
+  // thread only), which is all a worker thread reads.
+  static void MirrorPref(const nsACString& aPrefName);
+
+  // The userContextId per-context values are stored under: the principal's.
+  // A document without a browsing context of its own (createHTMLDocument,
+  // DOMParser) shares its creator's principal, so it finds its context's
+  // values where a browsing-context lookup found none.
+  static uint32_t UserContextId(nsIPrincipal* aPrincipal);
+  static uint32_t UserContextId(const nsINode* aNode);
+  static uint32_t UserContextId(nsPIDOMWindowInner* aWindow);
+
+  // Per-context window.setX() setters. A setter is offered to a window until
+  // its context has used it; aName names the setter's "used" flag.
+  static void MarkSetterUsed(const char* aName, uint32_t aUserContextId);
+  static bool IsSetterOffered(JSObject* aObj, const char* aName);
+  // Removes a setter the running script has just called from its global.
+  // Assigning undefined first busts the IC/shape caches that otherwise keep a
+  // deleted name reachable on ARM64.
+  static void RemoveSetter(const char* aName);
+
+ private:
+  static nsCString MakePrefName(const nsAString& key);
+  static void SetPrefValue(const nsCString& prefName, const nsCString& value);
+  static void SyncToParent(const nsCString& prefName, const nsCString& value);
+  static void ReadValue(const nsCString& prefName, nsACString& outValue);
+  static void EnsureMirror();
+  struct MemoSlot;
+  static MemoSlot ReadMemoized(const char* aPrefix, uint32_t aId);
+  static void BumpGeneration();
+  static nsTHashMap<nsCStringHashKey, nsCString>& GetLocalCache();
+  static mozilla::Mutex& GetLocalCacheMutex();
+};
+
+}  // namespace dom
+}  // namespace mozilla
+
+#endif  // mozilla_dom_RoverfoxStorageManager_h
