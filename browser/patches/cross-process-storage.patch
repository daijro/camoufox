index a3b9fd9ead..fb4011d2c3 100644
--- a/dom/ipc/ContentParent.cpp
+++ b/dom/ipc/ContentParent.cpp
@@ -1276,6 +1276,28 @@ mozilla::ipc::IPCResult ContentParent::RecvCreateGMPService() {
   return IPC_OK();
 }
 
+mozilla::ipc::IPCResult ContentParent::RecvRoverfoxStoragePut(
+    const nsCString& aPrefName, const nsCString& aValue) {
+  // Only allow roverfox-namespaced prefs for security
+  if (!StringBeginsWith(aPrefName, "roverfox.s."_ns)) {
+    return IPC_OK();
+  }
+  // Default branch: session state, never written to prefs.js (see
+  // RoverfoxStorageManager.cpp).
+  Preferences::SetCString(aPrefName.get(), aValue, PrefValueKind::Default);
+  return IPC_OK();
+}
+
+mozilla::ipc::IPCResult ContentParent::RecvRoverfoxStorageGet(
+    const nsCString& aPrefName, nsCString* aOutValue) {
+  if (!StringBeginsWith(aPrefName, "roverfox.s."_ns)) {
+    *aOutValue = ""_ns;
+    return IPC_OK();
+  }
+  Preferences::GetCString(aPrefName.get(), *aOutValue, PrefValueKind::Default);
+  return IPC_OK();
+}
+
