+/* static */
+bool WebIDLGlobalNameHash::DefineCreatedInterface(
+    JSContext* aCx, JS::Handle<JSObject*> aGlobal,
+    constructors::id::ID aConstructorId,
+    JS::Handle<JSObject*> aInterfaceObject) {
+  ProtoAndIfaceCache* cache = GetProtoAndIfaceCache(aGlobal);
+  cache->SetUndefinedOnGlobal(aConstructorId, false);
+
+  const bool isInterface = IsInterfaceObject(aInterfaceObject);
+  JSString* ownName =
+      isInterface
+          ? JS_GetMaybePartialFunctionId(JS_GetObjectFunction(aInterfaceObject))
+          : nullptr;
+  auto factoryNamed = [&](JSString* aName) -> JSObject* {
+    if (!isInterface) {
+      return nullptr;
+    }
+    for (unsigned slot = INTERFACE_OBJECT_FIRST_LEGACY_FACTORY_FUNCTION;
+         slot < INTERFACE_OBJECT_MAX_SLOTS; ++slot) {
+      const JS::Value& v = js::GetFunctionNativeReserved(aInterfaceObject, slot);
+      if (!v.isObject()) {
+        break;
+      }
+      if (JS_GetMaybePartialFunctionId(JS_GetObjectFunction(&v.toObject())) ==
+          aName) {
+        return &v.toObject();
+      }
+    }
+    return nullptr;
+  };
+
+  // Every enabled name of the interface, sorted into creation order.
+  JS::RootedVector<jsid> own(aCx), aliases(aCx), factories(aCx);
+  for (size_t i = 0; i < sCount; ++i) {
+    const WebIDLNameTableEntry& entry = sEntries[i];
+    if (entry.mConstructorId != aConstructorId ||
+        (entry.mEnabled && !entry.mEnabled(aCx, aGlobal))) {
+      continue;
+    }
+    JSString* name = JS_AtomizeStringN(aCx, BindingName(entry.mNameOffset),
+                                       entry.mNameLength);
+    if (!name) {
+      return false;
+    }
+    jsid id = JS::PropertyKey::NonIntAtom(name);
+    bool ok = (!isInterface || name == ownName) ? own.append(id)
+              : factoryNamed(name)               ? factories.append(id)
+                                                 : aliases.append(id);
+    if (!ok) {
+      return false;
+    }
+  }
+
+  JS::Rooted<jsid> id(aCx);
+  JS::Rooted<JSObject*> value(aCx);
+  for (auto* list : {&own, &aliases}) {
+    for (size_t i = 0; i < list->length(); ++i) {
+      id = (*list)[i];
+      if (!DefineOnGlobal(aCx, aGlobal, id, aInterfaceObject)) {
+        return false;
+      }
+    }
+  }
+  // Legacy factory functions in the order the interface created them.
+  if (isInterface) {
+    for (unsigned slot = INTERFACE_OBJECT_FIRST_LEGACY_FACTORY_FUNCTION;
+         slot < INTERFACE_OBJECT_MAX_SLOTS; ++slot) {
+      const JS::Value& v = js::GetFunctionNativeReserved(aInterfaceObject, slot);
+      if (!v.isObject()) {
+        break;
+      }
+      value = &v.toObject();
+      JSString* name = JS_GetMaybePartialFunctionId(JS_GetObjectFunction(value));
+      if (!name) {
+        continue;
+      }
+      id = JS::PropertyKey::NonIntAtom(name);
+      bool enabled = false;
+      for (size_t i = 0; i < factories.length(); ++i) {
+        enabled = enabled || factories[i] == id.get();
+      }
+      if (enabled && !DefineOnGlobal(aCx, aGlobal, id, value)) {
+        return false;
+      }
+    }
+  }
+  return true;
+}
