+/* static */
+bool WebIDLGlobalNameHash::DefineCreatedForPage(JSContext* aCx,
+                                                JS::Handle<JSObject*> aGlobal,
+                                                JS::Handle<JSObject*> aObject) {
+  // A page's own use of an interface defines it and the interfaces it
+  // inherits from, root first, as creating them would have. aObject is an
+  // interface prototype object or an interface object.
+  ProtoAndIfaceCache* cache = GetProtoAndIfaceCache(aGlobal);
+  JS::RootedVector<JSObject*> interfaces(aCx);
+  JS::Rooted<JSObject*> obj(aCx, aObject);
+  JS::Rooted<mozilla::Maybe<JS::PropertyDescriptor>> desc(aCx);
+  JS::Rooted<jsid> constructorId(
+      aCx, JS::PropertyKey::NonIntAtom(JS_AtomizeString(aCx, "constructor")));
+  if (IsInterfaceObject(obj)) {
+    if (!interfaces.append(obj)) {
+      return false;
+    }
+  } else {
+    while (obj) {
+      if (!JS_GetOwnPropertyDescriptorById(aCx, obj, constructorId, &desc)) {
+        return false;
+      }
+      if (desc.isSome() && desc->hasValue() && desc->value().isObject() &&
+          IsInterfaceObject(&desc->value().toObject()) &&
+          !interfaces.append(&desc->value().toObject())) {
+        return false;
+      }
+      JS::Rooted<JSObject*> proto(aCx);
+      if (!JS_GetPrototype(aCx, obj, &proto)) {
+        return false;
+      }
+      obj = proto;
+    }
+  }
+  JS::Rooted<JSObject*> iface(aCx);
+  for (size_t i = interfaces.length(); i-- > 0;) {
+    iface = interfaces[i];
+    JSString* name = JS_GetMaybePartialFunctionId(JS_GetObjectFunction(iface));
+    if (!name) {
+      continue;
+    }
+    const WebIDLNameTableEntry* entry =
+        GetEntry(JS::PropertyKey::NonIntAtom(name).toLinearString());
+    if (entry && cache->IsUndefinedOnGlobal(entry->mConstructorId) &&
+        !DefineCreatedInterface(aCx, aGlobal, entry->mConstructorId, iface)) {
+      return false;
+    }
+  }
+  // The prototypes' marks have done their job.
+  for (obj = aObject; obj;) {
+    const JSClass* clasp = JS::GetClass(obj);
+    if (IsDOMIfaceAndProtoClass(clasp)) {
+      const DOMIfaceAndProtoJSClass* protoClass =
+          DOMIfaceAndProtoJSClass::FromJSClass(clasp);
+      if (protoClass->mType == eInterfacePrototype ||
+          protoClass->mType == eGlobalInterfacePrototype) {
+        cache->SetUndefinedOnGlobal(protoClass->mPrototypeID, false);
+      }
+    }
+    JS::Rooted<JSObject*> proto(aCx);
+    if (!JS_GetPrototype(aCx, obj, &proto)) {
+      return false;
+    }
+    obj = proto;
+  }
+  return true;
+}
