+// Camoufox: whether the innermost script running is Juggler's, either its own
+// modules or the isolated worlds it evaluates page scripts in. Those sandboxes
+// carry the location of the Juggler code that created them.
+bool binding_detail::IsJugglerCaller(JSContext* aCx) {
+  if (!NS_IsMainThread()) {
+    return false;
+  }
+  constexpr auto kJuggler = "resource://gre/modules/juggler/"_ns;
+  // A call into the page, such as an event listener that Juggler's input
+  // reached, hides the scripted caller (CallSetup's AutoIncumbentScript), so
+  // the page is the one asking there, as for real input. The entry global is
+  // no guide: Juggler's actor messages enter the page's window too.
+  JSObject* callerGlobal = JS::GetScriptedCallerGlobal(aCx);
+  if (!callerGlobal) {
+    // A callback hides the caller and names its incumbent global instead:
+    // a listener in one of Juggler's isolated worlds (Playwright's hit
+    // target check) is Juggler's, a page's or a browser actor's is not.
+    nsIGlobalObject* incumbent = GetStackIncumbentGlobalUnclamped();
+    callerGlobal = incumbent ? incumbent->GetGlobalJSObjectPreserveColor()
+                             : nullptr;
+    if (!callerGlobal || !xpc::IsSandbox(callerGlobal)) {
+      return false;
+    }
+  }
+  if (xpc::IsSandbox(callerGlobal)) {
+    xpc::RealmPrivate* realm = xpc::RealmPrivate::Get(callerGlobal);
+    return realm && FindInReadable(kJuggler, realm->GetLocation());
+  }
+  // Described from the caller's own realm: from the page's, frames the page's
+  // principal does not subsume (Juggler's system modules) are not visible.
+  JSAutoRealm ar(aCx, callerGlobal);
+  JS::AutoFilename filename;
+  if (!JS::DescribeScriptedCaller(&filename, aCx) || !filename.get()) {
+    return false;
+  }
+  nsDependentCString caller(filename.get());
+  // A driver's main-world evaluate (Juggler's `mw:` path, and its own helpers
+  // in the main-world context) runs in the page's realm as Debugger code,
+  // which keeps the Debugger's default name, and the script the `mw:` wrapper
+  // evals is named after it ("debugger eval code line N > eval"). No script a
+  // page loads or evals is called that (//# sourceURL changes only the display
+  // name). What it creates is Juggler's, as from an isolated world: a
+  // scraper's document.querySelectorAll() there must not define NodeList on
+  // the window before the page uses it (main-world-eval-globals.py).
+  constexpr auto kDebuggerEval = "debugger eval code"_ns;
+  return StringBeginsWith(caller, kJuggler) ||
+         StringBeginsWith(caller, kDebuggerEval);
+}
