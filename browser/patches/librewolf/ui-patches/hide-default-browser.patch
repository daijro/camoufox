LibreWolf: hide the "set as default browser" UI in preferences.

Hides the settings rather than deleting them. chrome://browser/content/ is
contentaccessible, so a page can load preferences/main.js and read the order of
the globals it declares; removing the blocks outright changed that order away
from stock Firefox's. Guard: tests/patches/contentaccessible-parity.py.

diff --git a/browser/components/preferences/main.js b/browser/components/preferences/main.js
index f28e32899b..d98ea24917 100644
--- a/browser/components/preferences/main.js
+++ b/browser/components/preferences/main.js
@@ -367,7 +367,7 @@ Preferences.addSetting({
    * Show button for setting browser as default browser or information that
    * browser is already the default browser.
    */
-  visible: () => DefaultBrowserHelper.canCheck,
+  visible: () => false,
   disabled: (_, setting) =>
     !DefaultBrowserHelper.canCheck ||
     setting.locked ||
@@ -377,21 +377,13 @@ Preferences.addSetting({
 Preferences.addSetting({
   id: "isDefaultPane",
