-    DefaultBrowserHelper.canCheck &&
-    DefaultBrowserHelper.isBrowserDefault &&
-    Services.policies.isAllowed("setDefaultBrowser") &&
-    !Services.prefs.prefIsLocked("pref.general.disable_button.default_browser"),
