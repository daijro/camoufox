--- a/layout/base/nsLayoutUtils.cpp
+++ b/layout/base/nsLayoutUtils.cpp
@@ -4,6 +4,8 @@
 
 #include "nsLayoutUtils.h"
 
+#include "MaskConfig.hpp"
+#include "mozilla/dom/NavigatorManager.h"
 #include <algorithm>
 #include <limits>
 
@@ -9820,8 +9822,91 @@ already_AddRefed<nsFontMetrics> nsLayoutUtils::GetMetricsFor(
