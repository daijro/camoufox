 float nsGlobalWindowInner::GetMozInnerScreenY(CallerType aCallerType,
                                               ErrorResult& aError) {
-  FORWARD_TO_OUTER_OR_THROW(GetMozInnerScreenYOuter, (aCallerType), aError, 0);
+  const float stock = [&]() -> float {
+    FORWARD_TO_OUTER_OR_THROW(GetMozInnerScreenYOuter, (aCallerType), aError,
+                              0);
+  }();
+  if (aError.Failed() || aCallerType == CallerType::System ||
+      nsIGlobalObject::ShouldResistFingerprinting(
+          aCallerType, RFPTarget::WindowInnerScreenXY)) {
+    return stock;
+  }
+  return stock + SpoofedScreenShift(this).y.value;
+}
+
+/* static */
+CSSIntPoint nsGlobalWindowInner::SpoofedScreenShift(nsIGlobalObject* aGlobal) {
+  const auto x = MaskConfig::GetInt32("window.screenX");
+  const auto y = MaskConfig::GetInt32("window.screenY");
+  if (!x && !y) {
+    return {};
+  }
+  nsPIDOMWindowInner* inner = aGlobal ? aGlobal->GetAsInnerWindow() : nullptr;
+  nsGlobalWindowOuter* outer =
+      inner ? Cast(inner)->GetOuterWindowInternal() : nullptr;
+  if (!outer) {
+    return {};
+  }
+  IgnoredErrorResult rv;
+  const CSSIntPoint real = outer->GetScreenXY(CallerType::System, rv);
+  if (rv.Failed()) {
+    return {};
+  }
+  return CSSIntPoint(x ? *x - real.x : 0, y ? *y - real.y : 0);
 }
 
