diff --git a/dom/base/FontListManager.cpp b/dom/base/FontListManager.cpp
new file mode 100644
index 0000000000..cf06d78266
--- /dev/null
+++ b/dom/base/FontListManager.cpp
@@ -0,0 +1,92 @@
+/* Camoufox: Per-context font list manager */
+#include "FontListManager.h"
+
+#include "mozilla/Mutex.h"
+
+namespace mozilla {
+namespace dom {
+
+// The list itself lives in RoverfoxStorageManager, which every process reads:
+// a context's documents land in any content process, and only the first one
+// calls the setter. This is each process's parsed copy.
+static Mutex sFontListMutex("FontListManager");
+static nsTHashMap<nsUint32HashKey, nsTHashSet<nsCString>> sFontLists;
+static thread_local uint32_t sCurrentContextId = 0;
+
+static nsString FontListKey(uint32_t aId) {
+  nsAutoString key;
+  key.AppendPrintf("fontlist_%u", aId);
+  return key;
+}
+
+static nsTHashSet<nsCString> ParseFontList(const nsAString& aFontList) {
+  nsTHashSet<nsCString> fontSet;
+  nsAutoString remaining(aFontList);
+  while (!remaining.IsEmpty()) {
+    int32_t commaPos = remaining.FindChar(',');
+    nsAutoString fontName;
+    if (commaPos >= 0) {
+      fontName = Substring(remaining, 0, commaPos);
+      remaining.Cut(0, commaPos + 1);
+    } else {
+      fontName = remaining;
+      remaining.Truncate();
+    }
+    fontName.Trim(" \t");
+    if (fontName.IsEmpty()) continue;
+    nsAutoCString utf8;
+    CopyUTF16toUTF8(fontName, utf8);
+    ToLowerCase(utf8);
+    fontSet.Insert(utf8);
+  }
+  return fontSet;
+}
+
+void FontListManager::SetFontList(uint32_t aId, const nsAString& aFontList) {
+  RoverfoxStorageManager::PutString(FontListKey(aId), aFontList);
+  MutexAutoLock lock(sFontListMutex);
+  sFontLists.InsertOrUpdate(aId, ParseFontList(aFontList));
+}
+
+// Parses the context's list into this process's copy the first time it is
+// needed. An absent list is not remembered: another process may set it later.
+static bool EnsureFontList(uint32_t aId) {
+  {
+    MutexAutoLock lock(sFontListMutex);
+    if (sFontLists.Contains(aId)) return true;
+  }
+  nsAutoString list;
+  if (!RoverfoxStorageManager::GetString(FontListKey(aId), list)) return false;
+  MutexAutoLock lock(sFontListMutex);
+  sFontLists.InsertOrUpdate(aId, ParseFontList(list));
+  return true;
+}
+
+bool FontListManager::HasFontList(uint32_t aId) { return EnsureFontList(aId); }
+
+bool FontListManager::IsFontAllowed(uint32_t aId,
+                                     const nsACString& aFontName) {
+  if (!EnsureFontList(aId)) return true;
+  MutexAutoLock lock(sFontListMutex);
+  return sFontLists.Lookup(aId).Data().Contains(aFontName);
+}
+
+void FontListManager::SetCurrentContext(uint32_t aId) {
+  sCurrentContextId = aId;
+}
+
+uint32_t FontListManager::GetCurrentContext() {
+  return sCurrentContextId;
+}
+
+void FontListManager::DisableFunction(uint32_t aId) {
+  RoverfoxStorageManager::MarkSetterUsed("fontlist", aId);
+}
+
+bool FontListManager::IsFunctionEnabledForWebIDL(JSContext* aCx,
+                                                  JSObject* aObj) {
+  return RoverfoxStorageManager::IsSetterOffered(aObj, "fontlist");
+}
+
+}  // namespace dom
+}  // namespace mozilla
