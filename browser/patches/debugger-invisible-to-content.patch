+bool DebugAPI::allDebuggersInvisibleToContent(GlobalObject* global) {
+  JS::AutoSuppressGCAnalysis nogc;
+
+  bool any = false;
+  for (Realm::DebuggerVectorEntry& entry : global->getDebuggers(nogc)) {
+    any = true;
