+JS_PUBLIC_API bool IsScriptedCallerDebuggerCode(JSContext* cx) {
+  if (!cx->compartment()) {
+    return false;
+  }
+
+  NonBuiltinFrameIter i(cx, cx->realm()->principals());
+  if (i.done() || i.activation()->scriptedCallerIsHidden() || !i.hasScript()) {
+    return false;
+  }
+
+  // Code eval or Function compiled names the script that compiled it as its
+  // introduction script, so the walk ends at the outermost script.
+  for (BaseScript* script = i.script(); script;
+       script = script->sourceObject()->unwrappedIntroductionScript()) {
+    ScriptSource* ss = script->scriptSource();
+    if (ss->hasIntroductionType() &&
+        strcmp(ss->introductionType(), "debugger eval") == 0) {
+      return true;
+    }
+  }
+  return false;
+}
