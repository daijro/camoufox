+void Realm::updateAllDebuggersInvisibleToContent() {
+  MOZ_ASSERT(isDebuggee());
+
+  GlobalObject* global =
+      zone()->runtimeFromMainThread()->gc.isForegroundSweeping()
+          ? unsafeUnbarrieredMaybeGlobal()
+          : maybeGlobal();
+
+  // Execution tracing makes the realm a debuggee on its own, so it can't be
+  // hidden by the Debuggers that happen to be attached.
+  if (global && !isTracingExecution_ &&
+      DebugAPI::allDebuggersInvisibleToContent(global)) {
+    debugModeBits_ |= AllDebuggersInvisibleToContent;
+  } else {
+    debugModeBits_ &= ~AllDebuggersInvisibleToContent;
+  }
+}
