+const char js::HiddenDebuggerEvalIntroduction[] = "hidden debugger eval";
+
+// The introduction type of the Debugger evaluation that compiled |script|, or
+// that compiled the code eval or Function turned into |script|; null if none
+// did. The walk stops at anything else a script introduces, such as a script
+// element it adds to the document, which is the document's code.
+static const char* DebuggerEvalIntroduction(BaseScript* script) {
+  while (script) {
+    ScriptSource* ss = script->scriptSource();
+    if (!ss->hasIntroductionType()) {
+      return nullptr;
+    }
+    const char* type = ss->introductionType();
+    if (strcmp(type, "debugger eval") == 0 ||
+        strcmp(type, HiddenDebuggerEvalIntroduction) == 0) {
+      return type;
+    }
+    if (strcmp(type, "eval") != 0 && strcmp(type, "Function") != 0 &&
+        strcmp(type, "GeneratorFunction") != 0 &&
+        strcmp(type, "AsyncFunction") != 0 &&
+        strcmp(type, "AsyncGenerator") != 0) {
+      return nullptr;
+    }
+    script = script->sourceObject()->unwrappedIntroductionScript();
+  }
+  return nullptr;
+}
+
+bool js::IsDebuggerEvalCode(BaseScript* script) {
+  return DebuggerEvalIntroduction(script) != nullptr;
+}
+
+bool js::IsHiddenDebuggerEvalCode(BaseScript* script) {
+  const char* type = DebuggerEvalIntroduction(script);
+  return type && strcmp(type, HiddenDebuggerEvalIntroduction) == 0;
+}
