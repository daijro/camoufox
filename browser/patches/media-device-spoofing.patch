+bool MediaEngineFake::ServesIdentityDevices() const {
+  // GetBool returns std::optional<bool>: test the value, not its presence
+  // ("mediaDevices:enabled": false must disable them).
+  return mIdentityDevices &&
+         MaskConfig::GetBool("mediaDevices:enabled").value_or(false);
+}
