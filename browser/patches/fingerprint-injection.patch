 int32_t nsGlobalWindowInner::GetOuterWidth(CallerType aCallerType,
                                            ErrorResult& aError) {
+  // Camoufox: the inner and outer sizes are deliberately NOT read from
+  // MaskConfig. CamoufoxWindow.sys.mjs sizes the real window and content area
+  // to the drawn ones, so the real values are the identity's. A fixed value
+  // contradicted the real window whenever it ended up a different size (the WM
+  // clamped it, Juggler resized it for a viewport: innerWidth 1853 > outerWidth
+  // 1680 on GNOME), and every iframe and page-opened popup reported the main
+  // window's content size (#963).
   FORWARD_TO_OUTER_OR_THROW(GetOuterWidthOuter, (aCallerType, aError), aError,
                             0);
 }
