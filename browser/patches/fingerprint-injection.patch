 int32_t nsGlobalWindowInner::GetOuterWidth(CallerType aCallerType,
                                            ErrorResult& aError) {
+  // Camoufox: window.outerWidth/outerHeight are deliberately NOT read from
+  // MaskConfig. browser-init.js resizes the real window to the drawn size, and
+  // innerWidth/innerHeight report the real content area, so a fixed outer size
+  // contradicted inner whenever the window ended up a different size: the WM
+  // clamped or auto-maximized it, or Juggler resized it for a viewport. Pages
+  // then saw innerWidth > outerWidth (measured 1853 > 1680 on GNOME).
   FORWARD_TO_OUTER_OR_THROW(GetOuterWidthOuter, (aCallerType, aError), aError,
                             0);
 }
