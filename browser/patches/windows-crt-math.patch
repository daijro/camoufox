diff --git a/js/src/builtin/moz.build b/js/src/builtin/moz.build
--- a/js/src/builtin/moz.build
+++ b/js/src/builtin/moz.build
@@ -50,6 +50,19 @@
     "RegExp.cpp",
 ]
 
+# The Windows CRT's sin/cos/tan/pow for builds that present as Windows on
+# another OS (UcrtMath.h). Each operation must round exactly once, as the CRT's
+# instruction does, so no FP contraction; and the argument reduction needs a
+# 128-bit integer multiply, so 64-bit only. Windows itself uses the real CRT.
+if CONFIG["OS_ARCH"] != "WINNT" and CONFIG["HAVE_64BIT_BUILD"]:
+    DEFINES["JS_UCRT_MATH"] = True
+    SOURCES += [
+        "UcrtMathPow.c",
+        "UcrtMathTrig.c",
+    ]
+    SOURCES["UcrtMathPow.c"].flags += ["-ffp-contract=off"]
+    SOURCES["UcrtMathTrig.c"].flags += ["-ffp-contract=off"]
+
 selfhosted_inputs = [
     "../../public/friend/ErrorNumbers.msg",
     # ProfilingCategoryList.h is being indirectly included, and it must be passed
diff --git a/modules/libpref/init/StaticPrefList.yaml b/modules/libpref/init/StaticPrefList.yaml
--- a/modules/libpref/init/StaticPrefList.yaml
+++ b/modules/libpref/init/StaticPrefList.yaml
@@ -10251,6 +10251,16 @@
   mirror: always
   set_spidermonkey_pref: always
 
+# Whether Math.sin, Math.cos, Math.tan and Math.pow compute what the Windows
+# Universal CRT computes (its FMA3 code path), to the last bit, instead of
+# using this platform's libm. Overrides use_fdlibm_for_sin_cos_tan. Has no
+# effect on Windows, which already uses the CRT, or on 32-bit builds.
+- name: javascript.options.use_ucrt_math
+  type: bool
+  value: false
+  mirror: always
+  set_spidermonkey_pref: always
+
 # Attempt to dispatch multiple microtasks without doing a full
 # setup and teardown between each task.
 - name: javascript.options.batch_microtask_execution
