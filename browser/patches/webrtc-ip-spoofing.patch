+
+bool PeerConnectionImpl::ShouldSpoofCandidateIP() const {
+  return SpoofIP(false) || SpoofIP(true);
+}
+
+// *****
+// Helper functions to determine if IPs should be masked or not
+// *****
+
+bool isSpecialIP(const std::string& ip) {
+  // Check if an IP should not be masked (special addresses)
+  return (ip == "0.0.0.0" || ip == "127.0.0.1" ||
+          ip == "::" || ip == "::1" ||
+          ip.compare(0, 8, "169.254.") == 0 ||
+          ip.compare(0, 4, "fe80") == 0);
+}
+
+std::string getMaskForIP(const std::string& ip,
+                         const std::optional<std::string>& ipv4Value,
+                         const std::optional<std::string>& ipv6Value) {
+  // Get the corresponding mask for an ip address
+  if (isSpecialIP(ip)) {
+    return ip;  // dont mask special IPs
+  }
+  // Use colons AND no periods to avoid IPv4:port false positives
+  bool isIPv6 = (ip.find(':') != std::string::npos) && (ip.find('.') == std::string::npos);
+
+  if (isIPv6) {
+    if (ipv6Value) {
+      return ipv6Value.value();
+    }
+  } else {
+    if (ipv4Value) {
+      return ipv4Value.value();
+    }
+  }
+  // return original ip if no mask is available
+  return ip;
+}
+
+std::string replaceIPAddresses(const std::string& input, const char* pattern,
+                               const std::optional<std::string>& ipv4,
+                               const std::optional<std::string>& ipv6) {
+  // Replace IP addresses in a output line
+  mozilla::RustRegex regex(pattern);
+  if (!regex.IsValid()) {
+    return input;
+  }
+
+  std::string result;
+  auto iter = regex.IterMatches(input);
+  size_t lastEnd = 0;
+
+  while (auto match = iter.Next()) {
+    std::string ip = input.substr(match->start, match->end - match->start);
+    std::string mask = getMaskForIP(ip, ipv4, ipv6);
+
+    if (mask != ip) {
+      result.append(input, lastEnd, match->start - lastEnd);
+      result.append(mask);
+    } else {
+      result.append(input, lastEnd, match->end - lastEnd);
+    }
+
+    lastEnd = match->end;
+  }
+
+  result.append(input, lastEnd);
+  return result;
+}
+
+std::string PeerConnectionImpl::SpoofCandidateIP(const std::string& candidate) {
+  if (!ShouldSpoofCandidateIP() || candidate.empty()) {
+    return candidate;
+  }
+
+  const auto ipv4 = SpoofIP(false);
+  const auto ipv6 = SpoofIP(true);
+
+  // ipv4
+  const char* ipv4Pattern = "(?:(?:25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\\.){3}(?:25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)";
+  std::string result = replaceIPAddresses(candidate, ipv4Pattern, ipv4, ipv6);
+  // ipv6 - comprehensive pattern handles all formats including compressed (::1, fe80::, etc.)
+  const char* ipv6Pattern = "(?:(?:[0-9A-Fa-f]{1,4}:){7}[0-9A-Fa-f]{1,4}|(?:[0-9A-Fa-f]{1,4}:){1,7}:|(?:[0-9A-Fa-f]{1,4}:){1,6}:[0-9A-Fa-f]{1,4}|(?:[0-9A-Fa-f]{1,4}:){1,5}(?::[0-9A-Fa-f]{1,4}){1,2}|(?:[0-9A-Fa-f]{1,4}:){1,4}(?::[0-9A-Fa-f]{1,4}){1,3}|(?:[0-9A-Fa-f]{1,4}:){1,3}(?::[0-9A-Fa-f]{1,4}){1,4}|(?:[0-9A-Fa-f]{1,4}:){1,2}(?::[0-9A-Fa-f]{1,4}){1,5}|[0-9A-Fa-f]{1,4}:(?::[0-9A-Fa-f]{1,4}){1,6}|:(?::[0-9A-Fa-f]{1,4}){1,7}|::)";
+  result = replaceIPAddresses(result, ipv6Pattern, ipv4, ipv6);
+
+  return result;
+}
+
+nsresult PeerConnectionImpl::SanitizeSDPForIPLeak(std::string& sdp) {
+  if (!ShouldSpoofCandidateIP()) {
+    return NS_OK;
+  }
+
+  const auto ipv4 = SpoofIP(false);
+  const auto ipv6 = SpoofIP(true);
+
+  // process the SDP line by line to handle candidate lines
+  std::istringstream iss(sdp);
+  std::ostringstream oss;
+  std::string line;
+
+  while (std::getline(iss, line)) {
+    // process candidates and other lines that might contain IPs
+    if (line.compare(0, 12, "a=candidate:") == 0) {
+      std::string processed = SpoofCandidateIP(line);
+      if (processed != line) {
+        line = processed;
+      }
+    }
+    // add line back with proper line ending
+    if (line.empty() || (line.back() != '\r' && line.back() != '\n')) {
+      oss << line << "\r\n";
+    } else {
+      oss << line;
+    }
+  }
+  // process the entire SDP for any remaining IP addresses
+  std::string processedSdp = oss.str();
+  std::string originalSdp = processedSdp;
+
+  // ipv4
+  const char* ipv4Pattern = "(?:(?:25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\\.){3}(?:25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)";
+  processedSdp = replaceIPAddresses(processedSdp, ipv4Pattern, ipv4, ipv6);
+  // ipv6 - comprehensive pattern handles all formats including compressed (::1, fe80::, etc.)
+  const char* ipv6Pattern = "(?:(?:[0-9A-Fa-f]{1,4}:){7}[0-9A-Fa-f]{1,4}|(?:[0-9A-Fa-f]{1,4}:){1,7}:|(?:[0-9A-Fa-f]{1,4}:){1,6}:[0-9A-Fa-f]{1,4}|(?:[0-9A-Fa-f]{1,4}:){1,5}(?::[0-9A-Fa-f]{1,4}){1,2}|(?:[0-9A-Fa-f]{1,4}:){1,4}(?::[0-9A-Fa-f]{1,4}){1,3}|(?:[0-9A-Fa-f]{1,4}:){1,3}(?::[0-9A-Fa-f]{1,4}){1,4}|(?:[0-9A-Fa-f]{1,4}:){1,2}(?::[0-9A-Fa-f]{1,4}){1,5}|[0-9A-Fa-f]{1,4}:(?::[0-9A-Fa-f]{1,4}){1,6}|:(?::[0-9A-Fa-f]{1,4}){1,7}|::)";
+  processedSdp = replaceIPAddresses(processedSdp, ipv6Pattern, ipv4, ipv6);
+
+  if (processedSdp != originalSdp) {
+    sdp = processedSdp;
+  }
+
+  return NS_OK;
+}
+
+// *****
+// Host candidates for a gather that surfaced none
+// *****
+
+// A fresh random ephemeral port per PeerConnection. Real Firefox binds a new
+// UDP socket per PeerConnection and REUSES that port for the host candidate and
+// its srflx; we mirror that (one port, shared, random per PC) -- never derived
+// from the IP. The only observable pattern is the RANGE: it must be the OS
+// ephemeral range of the OS the context presents; Linux's when no platform is
+// configured.
+static uint16_t RandomEphemeralPort(uint32_t aUserContextId) {
+  const auto [lo, hi] =
+      MaskConfig::SpoofedEphemeralPorts(
+          dom::NavigatorManager::GetSpoofedOS(aUserContextId))
+          .value_or(std::pair<uint16_t, uint16_t>{32768, 60999});
+  uint32_t span = static_cast<uint32_t>(hi - lo) + 1u;
+  return static_cast<uint16_t>(lo + (mozilla::RandomUint64OrDie() % span));
+}
+
+// Extract the value of the first "<prefix><value>" line in an SDP (prefix like
+// "a=mid:" or "a=ice-ufrag:"). Returns empty string if not found.
