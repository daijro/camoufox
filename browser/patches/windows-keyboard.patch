+// Windows has no native text bindings: its shortcut tables, which ShortcutKeys
+// uses for an identity with "input:windowsKeyboard", are the whole behaviour.
+static bool CamouWindowsKeyboard() {
+  static const bool sWindowsKeyboard =
+      MaskConfig::GetBool("input:windowsKeyboard");
+  return sWindowsKeyboard;
+}
