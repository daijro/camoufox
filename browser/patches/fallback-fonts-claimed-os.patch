+
 void gfxPlatformGtk::GetCommonFallbackFonts(uint32_t aCh, Script aRunScript,
                                             FontPresentation aPresentation,
                                             nsTArray<const char*>& aFontList) {
+  // The launch identity's OS: the table has no document to key a per-context
+  // identity by, and the font.name-list prefs it works with are process-wide.
+  switch (MaskConfig::GetSpoofedOS()) {
+    case MaskConfig::SpoofedOS::Windows:
+      camou_fallback::CamouWindowsCommonFallbackFonts(aCh, aRunScript,
+                                                      aPresentation, aFontList);
+      return;
+    case MaskConfig::SpoofedOS::MacOS:
+      camou_fallback::CamouMacCommonFallbackFonts(aCh, aRunScript,
+                                                  aPresentation, aFontList);
+      return;
+    default:
+      break;
+  }
+
   if (PrefersColor(aPresentation)) {
     aFontList.AppendElement(kFontTwemojiMozilla);
   }
