@@ -0,0 +1,48 @@
+/* Camoufox: Per-context navigator property manager */
+#include "NavigatorManager.h"
+#include "MaskConfig.hpp"
+
+namespace mozilla {
+namespace dom {
+
+/* static */
+MaskConfig::SpoofedOS NavigatorManager::GetSpoofedOS(uint32_t aId) {
+  nsAutoString platform;
+  if (GetPlatform(aId, platform)) {
+    return MaskConfig::SpoofedOSFor(NS_ConvertUTF16toUTF8(platform).get());
+  }
+  return MaskConfig::GetSpoofedOS();
+}
+
+/* static */
+bool NavigatorManager::IsPlatformFunctionEnabledForWebIDL(JSContext* aCx,
+                                                          JSObject* aObj) {
+  return RoverfoxStorageManager::IsSetterOffered(aObj, "nav_plat");
+}
+
+/* static */
+bool NavigatorManager::IsOscpuFunctionEnabledForWebIDL(JSContext* aCx,
+                                                       JSObject* aObj) {
+  return RoverfoxStorageManager::IsSetterOffered(aObj, "nav_oscpu");
+}
+
+/* static */
+bool NavigatorManager::IsHwcFunctionEnabledForWebIDL(JSContext* aCx,
+                                                     JSObject* aObj) {
+  return RoverfoxStorageManager::IsSetterOffered(aObj, "nav_hwc");
+}
+
+/* static */
+bool NavigatorManager::IsUaFunctionEnabledForWebIDL(JSContext* aCx,
+                                                    JSObject* aObj) {
+  return RoverfoxStorageManager::IsSetterOffered(aObj, "nav_ua");
+}
+
+/* static */
+bool NavigatorManager::IsAppVersionFunctionEnabledForWebIDL(JSContext* aCx,
+                                                            JSObject* aObj) {
+  return RoverfoxStorageManager::IsSetterOffered(aObj, "nav_appver");
+}
+
+}  // namespace dom
+}  // namespace mozilla
diff --git a/dom/base/NavigatorManager.h b/dom/base/NavigatorManager.h
new file mode 100644
index 0000000000..3df7f14e9e
--- /dev/null
+++ b/dom/base/NavigatorManager.h
@@ -0,0 +1,112 @@
+/* Camoufox: Per-context navigator property manager */
+#ifndef mozilla_dom_NavigatorManager_h
+#define mozilla_dom_NavigatorManager_h
+
+#include "nsString.h"
+#include "RoverfoxStorageManager.h"
+
+namespace MaskConfig {
+enum class SpoofedOS;
+}
+
+namespace mozilla {
+namespace dom {
+
+class NavigatorManager {
+ public:
+  // Platform (e.g. "Win32", "MacIntel", "Linux x86_64")
+  static void SetPlatform(uint32_t aId, const nsAString& aValue) {
+    nsAutoString key;
+    key.AppendPrintf("nav_plat_%u", aId);
+    RoverfoxStorageManager::PutString(key, aValue);
+    RoverfoxStorageManager::MarkSetterUsed("nav_plat", aId);
+  }
+
+  static bool GetPlatform(uint32_t aId, nsAString& aOut) {
+    nsAutoString key;
+    key.AppendPrintf("nav_plat_%u", aId);
+    return RoverfoxStorageManager::GetString(key, aOut);
+  }
+
+  static bool IsPlatformFunctionEnabledForWebIDL(JSContext* aCx,
+                                                 JSObject* aObj);
+
+  // The OS a context presents: its own navigator.platform when it set one,
+  // else the launch's, as Navigator::GetPlatform answers.
+  static MaskConfig::SpoofedOS GetSpoofedOS(uint32_t aId);
+
+  // Oscpu (e.g. "Windows NT 10.0; Win64; x64")
+  static void SetOscpu(uint32_t aId, const nsAString& aValue) {
+    nsAutoString key;
+    key.AppendPrintf("nav_oscpu_%u", aId);
+    RoverfoxStorageManager::PutString(key, aValue);
+    RoverfoxStorageManager::MarkSetterUsed("nav_oscpu", aId);
+  }
+
+  static bool GetOscpu(uint32_t aId, nsAString& aOut) {
+    nsAutoString key;
+    key.AppendPrintf("nav_oscpu_%u", aId);
+    return RoverfoxStorageManager::GetString(key, aOut);
+  }
+
+  static bool IsOscpuFunctionEnabledForWebIDL(JSContext* aCx, JSObject* aObj);
+
+  // HardwareConcurrency (CPU core count)
+  static void SetHardwareConcurrency(uint32_t aId, uint32_t aValue) {
+    nsAutoString key;
+    key.AppendPrintf("nav_hwc_%u", aId);
+    RoverfoxStorageManager::PutUint(key, aValue);
+    RoverfoxStorageManager::MarkSetterUsed("nav_hwc", aId);
+  }
+
+  static uint32_t GetHardwareConcurrency(uint32_t aId) {
+    nsAutoString key;
+    key.AppendPrintf("nav_hwc_%u", aId);
+    uint32_t value = 0;
+    if (RoverfoxStorageManager::GetUint(key, value)) {
+      return value;
+    }
+    return 0;
+  }
+
+  static bool IsHwcFunctionEnabledForWebIDL(JSContext* aCx, JSObject* aObj);
+
+  // UserAgent (e.g. "Mozilla/5.0 (Macintosh; Intel Mac OS X 10.15; rv:146.0)...")
+  static void SetUserAgent(uint32_t aId, const nsAString& aValue) {
+    nsAutoString key;
+    key.AppendPrintf("nav_ua_%u", aId);
+    RoverfoxStorageManager::PutString(key, aValue);
+    RoverfoxStorageManager::MarkSetterUsed("nav_ua", aId);
+  }
+
+  static bool GetUserAgent(uint32_t aId, nsAString& aOut) {
+    nsAutoString key;
+    key.AppendPrintf("nav_ua_%u", aId);
+    return RoverfoxStorageManager::GetString(key, aOut);
+  }
+
+  static bool IsUaFunctionEnabledForWebIDL(JSContext* aCx, JSObject* aObj);
+
+  // AppVersion (e.g. "5.0 (Macintosh)")
+  static void SetAppVersion(uint32_t aId, const nsAString& aValue) {
+    nsAutoString key;
+    key.AppendPrintf("nav_appver_%u", aId);
+    RoverfoxStorageManager::PutString(key, aValue);
+    RoverfoxStorageManager::MarkSetterUsed("nav_appver", aId);
+  }
+
+  static bool GetAppVersion(uint32_t aId, nsAString& aOut) {
+    nsAutoString key;
+    key.AppendPrintf("nav_appver_%u", aId);
+    return RoverfoxStorageManager::GetString(key, aOut);
+  }
+
+  static bool IsAppVersionFunctionEnabledForWebIDL(JSContext* aCx,
+                                                   JSObject* aObj);
+
+};
+
+}  // namespace dom
+}  // namespace mozilla
+
+#endif  // mozilla_dom_NavigatorManager_h
