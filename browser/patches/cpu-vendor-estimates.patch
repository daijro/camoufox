+// ARM FMIN/FMAX: NaN operands propagate as FPProcessNaNs picks them (a
+// signalling NaN first, then the first operand), quieted; -0 < +0.
+void MacroAssemblerX86Shared::armMinMaxSimd128(bool isMax, bool isDouble,
+                                               FloatRegister lhs,
+                                               FloatRegister rhs,
+                                               FloatRegister dest) {
+  MacroAssembler& masm = asMasm();
+  ScratchSimd128Scope k(masm);
+  ArmEmuTemps T(masm, 6, {lhs, rhs, dest});
+  ArmEmuOps o{masm, isDouble};
+  FloatRegister a = T[0], b = T[1], r = T[2], t = T[3], x = T[4], y = T[5];
+  o.mov(lhs, a);
+  o.mov(rhs, b);
+
+  // Ordered lanes: both operand orders agree except on zeros, where OR keeps
+  // a -0 (min) and AND keeps a +0 (max).
+  auto op = [&](FloatRegister d, FloatRegister s) {
+    if (isDouble) {
+      isMax ? masm.vmaxpd(Operand(s), d, d) : masm.vminpd(Operand(s), d, d);
+    } else {
+      isMax ? masm.vmaxps(Operand(s), d, d) : masm.vminps(Operand(s), d, d);
+    }
+  };
+  o.mov(a, r);
+  op(r, b);
+  o.mov(b, t);
+  op(t, a);
+  isMax ? o.and_(r, t) : o.or_(r, t);
+
+  // NaN lanes: b when b is signalling and a is not, or a is not NaN; else a.
+  o.snan(b, x, t, k);  // x = snan(b)
+  o.mov(a, y);
+  o.quietBit(k);
+  o.and_(y, k);
+  o.eq(y, k);  // y = a has the quiet bit
+  o.and_(x, y);
+  o.mov(a, y);
+  o.unord(y, a);  // y = isNaN(a)
+  o.andn(x, y);   // x = pickA = isNaN(a) & ~(quiet(a) & snan(b))
+  o.mov(b, y);
+  o.blend(y, a, x, t);  // y = pickA ? a : b
+  o.quietBit(k);
+  o.or_(y, k);
+  o.mov(a, x);
+  o.unord(x, b);  // either NaN
+  o.blend(r, y, x, t);
+  o.mov(r, dest);
+}
+
+// ARM FMLA/FMLS: fused, NaN operands propagate by FPProcessNaNs3 with the
+// addend first (FMLS negates the first factor before, flipping a NaN's
+// sign), a quiet-NaN addend with an inf*0 product gives the default NaN, and
+// the default NaN is positive.
+void MacroAssemblerX86Shared::armFmaSimd128(bool negate, bool isDouble,
+                                            FloatRegister src1,
+                                            FloatRegister src2,
+                                            FloatRegister srcDest) {
+  MacroAssembler& masm = asMasm();
+  ScratchSimd128Scope k(masm);
+  ArmEmuTemps T(masm, 10, {src1, src2, srcDest});
+  ArmEmuOps o{masm, isDouble};
+  FloatRegister A = T[0], B = T[1], C = T[2], r = T[3], v = T[4], x = T[5],
+                m = T[6], t = T[7], p = T[8], q = T[9];
+  o.mov(src1, A);
+  o.mov(src2, B);
+  o.mov(srcDest, C);
+  if (negate) {
+    o.signBit(k);
+    o.xor_(A, k);
+  }
+
+  o.mov(C, r);
+  if (HasFMA()) {
+    if (isDouble) {
+      masm.vfmadd231pd(B, A, r);
+    } else {
+      masm.vfmadd231ps(B, A, r);
+    }
+  } else {
+    // No FMA unit: unfused, so not ARM's rounding in every case.
+    o.mov(A, t);
+    if (isDouble) {
+      masm.vmulpd(Operand(B), t, t);
+      masm.vaddpd(Operand(t), r, r);
+    } else {
+      masm.vmulps(Operand(B), t, t);
+      masm.vaddps(Operand(t), r, r);
+    }
+  }
+
+  // The NaN an ARM core returns, lowest priority first.
+  o.defaultNaN(v);
+  FloatRegister order[3] = {B, A, C};
+  for (FloatRegister s : order) {  // quiet NaNs
+    o.mov(s, m);
+    o.unord(m, s);
+    o.mov(s, x);
+    o.quietBit(k);
+    o.or_(x, k);
+    o.blend(v, x, m, t);
+  }
+  for (FloatRegister s : order) {  // signalling NaNs
+    o.snan(s, m, t, k);
+    o.mov(s, x);
+    o.quietBit(k);
+    o.or_(x, k);
+    o.blend(v, x, m, t);
+  }
+  // A quiet-NaN addend loses to the default NaN when the product is inf*0.
+  o.absMask(k);
+  o.mov(A, m);
+  o.and_(m, k);
+  o.mov(B, p);
+  o.and_(p, k);
+  o.mov(m, x);
+  o.mov(p, q);
+  o.infBits(k);
+  o.eq(m, k);  // inf(A)
+  o.eq(p, k);  // inf(B)
+  o.xor_(t, t);
+  o.eq(x, t);  // zero(A)
+  o.eq(q, t);  // zero(B)
+  o.and_(m, q);
+  o.and_(p, x);
+  o.or_(m, p);  // inf*0
+  o.mov(C, x);
+  o.unord(x, C);
+  o.mov(C, p);
+  o.quietBit(k);
+  o.and_(p, k);
+  o.eq(p, k);
+  o.and_(x, p);  // quiet NaN addend
+  o.and_(m, x);
+  o.defaultNaN(x);
+  o.blend(v, x, m, t);
+
+  o.mov(r, m);
+  o.unord(m, r);
+  o.blend(r, v, m, t);
+  o.mov(r, srcDest);
+}
+
+// ARM BSL: a bitwise select, not a byte blend on the mask's top bit.
+void MacroAssemblerX86Shared::armLaneSelectSimd128(FloatRegister mask,
+                                                   FloatRegister lhs,
+                                                   FloatRegister rhs,
+                                                   FloatRegister dest) {
+  MacroAssembler& masm = asMasm();
+  ArmEmuTemps T(masm, 3, {mask, lhs, rhs, dest});
+  ArmEmuOps o{masm, false};
+  o.mov(rhs, T[0]);
+  o.mov(lhs, T[1]);
+  o.blend(T[0], T[1], mask, T[2]);
+  o.mov(T[0], dest);
+}
+
+// ARM SMULL/SMULL2/ADDP: both operands signed, the pair sum wraps at 16 bits
+// (x86's PMADDUBSW takes lhs unsigned and saturates). With `add`, SADALP
+// widens the pair sums into the int32 accumulator `dest`.
+void MacroAssemblerX86Shared::armDotInt8x16Int7x16(FloatRegister lhs,
+                                                   FloatRegister rhs,
+                                                   FloatRegister dest,
+                                                   bool add) {
+  MacroAssembler& masm = asMasm();
+  ArmEmuTemps T(masm, 4, {lhs, rhs, dest});
+  ArmEmuOps o{masm, false};
+  FloatRegister ae = T[0], be = T[1], ao = T[2], bo = T[3];
+  o.mov(lhs, ae);
+  o.mov(rhs, be);
+  o.mov(lhs, ao);
+  o.mov(rhs, bo);
+  masm.vpsllw(Imm32(8), ae, ae);
+  masm.vpsraw(Imm32(8), ae, ae);  // even bytes, sign-extended
+  masm.vpsllw(Imm32(8), be, be);
+  masm.vpsraw(Imm32(8), be, be);
+  masm.vpsraw(Imm32(8), ao, ao);  // odd bytes, sign-extended
+  masm.vpsraw(Imm32(8), bo, bo);
+  masm.vpmullw(Operand(be), ae, ae);
+  masm.vpmullw(Operand(bo), ao, ao);
+  masm.vpaddw(Operand(ao), ae, ae);
+  if (add) {
+    masm.loadConstantSimd128(SimdConstant::SplatX8(1), be);
+    masm.vpmaddwd(Operand(be), ae, ae);
+    masm.vpaddd(Operand(ae), dest, dest);
+  } else {
+    o.mov(ae, dest);
+  }
+}
+
+// ARM FCVTZS/FCVTZU (then SQXTN/UQXTN for f64x2): saturating, NaN -> 0, the
+// same as the non-relaxed trunc_sat ops.
+void MacroAssemblerX86Shared::armTruncSimd128(bool isUnsigned, bool isDouble,
+                                              FloatRegister src,
+                                              FloatRegister dest) {
+  MacroAssembler& masm = asMasm();
+  ArmEmuTemps T(masm, 3, {src, dest});
+  masm.vmovdqa(src, T[0]);
+  if (isDouble) {
+    if (isUnsigned) {
+      unsignedTruncSatFloat64x2ToInt32x4(T[0], T[1], T[2]);
+    } else {
+      truncSatFloat64x2ToInt32x4(T[0], T[1], T[2]);
+    }
+  } else {
+    if (isUnsigned) {
+      unsignedTruncSatFloat32x4ToInt32x4(T[0], T[1], T[2]);
+    } else {
+      truncSatFloat32x4ToInt32x4(T[0], T[2]);
+    }
+  }
+  masm.vmovdqa(T[2], dest);
+}
