+/* Another vendor's RCPPS/RSQRTPS, when Gecko set a table (opus_cpu_estimates.h). */
+static __m128 estimate_as(__m128 v, int rsqrt)
+{
+   const uint32_t *table = opus_mozilla_cpu_estimates();
+   uint32_t b[4];
+   int i;
+   if (!table)
+      return rsqrt ? _mm_rsqrt_ps(v) : _mm_rcp_ps(v);
+   _mm_storeu_ps((float*)(void*)b, v);
+   for (i=0;i<4;i++)
+      b[i] = rsqrt ? sk_cpu_estimate_rsqrt(table, b[i]) : sk_cpu_estimate_rcp(table, b[i]);
+   return _mm_loadu_ps((float*)(void*)b);
+}
