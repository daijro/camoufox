+    Fcmgt(Simd2D(scratch), Simd2D(src), Simd2D(scratch));
+    And(Simd16B(t[0]), Simd16B(t[0]), Simd16B(scratch));
+    Fcvtzs(Simd2D(t[1]), Simd2D(src));
+    asMasm().loadConstantSimd128(SimdConstant::SplatX2(int64_t(0x80000000)),
+                                 scratch);
+    Bsl(Simd16B(t[0]), Simd16B(t[1]), Simd16B(scratch));
+    Xtn(Simd2S(dest), Simd2D(t[0]));
+    return;
+  }
+  // cvttps2dq: a NaN or a lane at or above 2^31 gives 0x80000000 where FCVTZS
+  // gives 0 or 0x7fffffff; below -2^31 both give 0x80000000.
+  auto cvttps2dq = [&](FloatRegister in, FloatRegister out) {
+    Movi(Simd4S(scratch), 0x4f, vixl::LSL, 24);
+    Fcmgt(Simd4S(scratch), Simd4S(scratch), Simd4S(in));
+    Fcvtzs(Simd4S(out), Simd4S(in));
+    And(Simd16B(out), Simd16B(out), Simd16B(scratch));
+    Mvn(Simd16B(scratch), Simd16B(scratch));
+    Shl(Simd4S(scratch), Simd4S(scratch), 31);
+    Orr(Simd16B(out), Simd16B(out), Simd16B(scratch));
+  };
+  if (!isUnsigned) {
+    cvttps2dq(src, dest);
+    return;
+  }
+  // The x64 sequence: convert the lanes below 2^31 with cvttps2dq, and add
+  // the others' bits, doubled and shifted left by 8.
+  X86EmuTemps t(asMasm(), 1, {src, dest});
+  FloatRegister high = t[0];
+  Movi(Simd4S(high), 0x4f, vixl::LSL, 24);
+  Fcmgt(Simd4S(high), Simd4S(src), Simd4S(high));
+  And(Simd16B(high), Simd16B(high), Simd16B(src));
+  Eor(Simd16B(dest), Simd16B(src), Simd16B(high));
+  cvttps2dq(dest, dest);
+  Fadd(Simd4S(high), Simd4S(high), Simd4S(high));
+  Shl(Simd4S(high), Simd4S(high), 8);
+  Add(Simd4S(dest), Simd4S(dest), Simd4S(high));
+}
+
 }  // namespace jit
 }  // namespace js
