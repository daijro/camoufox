+// Whether to compute as an ARM64 CPU does where x86-64 and ARM64 give
+// different bits (Camoufox's general.cpu_identity, JS::SetEmulateArm64): the
+// sign of the NaN an invalid operation makes, and the relaxed SIMD
+// instructions. Set once, before JS_Init.
+extern bool EmulateArm64;
+
+// A NaN as an ARM64 CPU would hand it to memory. x86's SSE makes the
+// negative default NaN (0xFFF8000000000000) where ARM64 makes the positive
+// one, and that NaN is a valid double Value, so it reaches typed arrays and
+// DataViews as computed. Stores clear the sign of a NaN instead of tracking
+// where it came from; a NaN the script negated on purpose stores positive too.
+inline double ArmNaN(double d) {
+  if (EmulateArm64 && d != d) {
+    return mozilla::BitwiseCast<double>(mozilla::BitwiseCast<uint64_t>(d) &
+                                        ~(uint64_t(1) << 63));
+  }
+  return d;
+}
