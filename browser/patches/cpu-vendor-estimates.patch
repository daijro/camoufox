+// sign of the NaN an invalid operation makes, and the relaxed SIMD
+// instructions. Set once, before JS_Init.
+extern bool EmulateArm64;
+
+// A NaN as an ARM64 CPU would hand it to memory. x86's SSE makes the
+// negative default NaN (0xFFF8000000000000) where ARM64 makes the positive
+// one, and that NaN is a valid double Value, so it reaches typed arrays and
+// DataViews as computed. Stores clear the sign of a NaN instead of tracking
+// where it came from; a NaN the script negated on purpose stores positive too.
+inline double ArmNaN(double d) {
+  if (EmulateArm64 && d != d) {
+    return mozilla::BitwiseCast<double>(mozilla::BitwiseCast<uint64_t>(d) &
+                                        ~(uint64_t(1) << 63));
+  }
+  return d;
+}
+
+// Whether to compute as an x86-64 CPU does where ARM64 and x86-64 give
+// different bits (general.cpu_identity 1 or 2 on an ARM64 build,
+// JS::SetEmulateX86): the sign of the NaN an invalid operation makes, and the
+// relaxed SIMD instructions. Set once, before JS_Init.
+extern bool EmulateX86;
+
+// The result `r` of a floating-point operation on `a` and `b` as x86's SSE
+// gives it. An invalid operation on non-NaN operands (Infinity - Infinity,
+// 0 * Infinity, sqrt(-1)) makes the negative default NaN there and the
+// positive one on ARM64; a NaN operand propagates the same on both. Unlike
+// the stores ArmNaN covers, the sign has to be set where the NaN is made,
+// because x86 keeps the positive NaN a script writes.
+inline double X86NaN(double r, double a, double b = 0) {
