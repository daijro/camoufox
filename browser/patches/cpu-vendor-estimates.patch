@@ -7101,6 +7101,20 @@
 # Prefs starting with "general."
 #---------------------------------------------------------------------------
 
+# The CPU whose arithmetic the browser reproduces where CPUs give different
+# bits: 0 the CPU it runs on, 1 an Intel x86-64, 2 an AMD x86-64, 3 an ARM64.
+# Intel's and AMD's RCPPS/RSQRTPS estimates differ, and reach canvas readback
+# through Skia's blend modes, perspective and matrix inversion, and encoded
+# Opus through the PVQ search (SkCpuEstimates.h, opus_cpu_estimates.h). An
+# ARM64 CPU also rounds Skia's raster pipeline, Web Audio's FFT and mixing and
+# Opus differently (fused multiply-adds, NEON estimates), makes positive NaNs
+# and answers relaxed SIMD with other lanes (JS::SetEmulateArm64). A value
+# naming the CPU it runs on changes nothing. Read at startup.
+- name: general.cpu_identity
+  type: RelaxedAtomicUint32
+  value: 0
+  mirror: always
+
 - name: general.aboutConfig.enable
   type: bool
   value: true
@@ -13562,6 +13576,15 @@
   mirror: always
 
 # WebM
+# Encode VP8 and VP9 as Firefox's Windows and Linux arm64 builds do: their
+# libvpx is built realtime-only, which rejects VP8 with lookahead and gives
+# VP9 another bitstream in quality mode. macOS arm64 and x86 builds are not.
+# Read when each encoder is created.
+- name: media.libvpx.realtime_only
+  type: RelaxedAtomicBool
+  value: false
+  mirror: always
+
 - name: media.webm.enabled
   type: RelaxedAtomicBool
   value: true
