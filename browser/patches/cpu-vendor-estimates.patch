+// ===============================================================
+// x86 emulation (general.cpu_identity 1 or 2 on ARM64).
+//
+// x86's SSE makes the negative default NaN where ARM64 makes the positive one,
+// and relaxed SIMD lets each CPU pick its own result for out-of-range swizzle
+// indices, NaN and signed-zero min/max, overflowing truncation, lane select,
+// the i7 dot product, the q15 multiply overflow and the NaN of a fused
+// multiply-add. When EmulateX86 is set, these lower to the result
+// SpiderMonkey's x64 backend gets on an AVX2 and FMA core instead of the ARM64
+// one. The deterministic SIMD ops are unchanged.
+
+namespace {
+
+// Up to kMax SIMD registers borrowed for the length of one operation: they are
+// saved below the stack pointer's current frame and restored on scope exit.
+// The scratch register and the registers in `avoid` are never taken.
+class X86EmuTemps {
+  static constexpr size_t kMax = 4;
+  MacroAssembler& masm_;
+  FloatRegister regs_[kMax];
+  size_t count_ = 0;
+
+ public:
+  X86EmuTemps(MacroAssembler& masm, size_t count,
+              std::initializer_list<FloatRegister> avoid)
+      : masm_(masm) {
+    MOZ_RELEASE_ASSERT(count <= kMax);
+    for (uint32_t code = 0; count_ < count && code < FloatRegisters::TotalPhys;
+         code++) {
+      FloatRegister r(FloatRegisters::Encoding(code), FloatRegisters::Simd128);
+      bool taken = r.encoding() == ScratchSimd128Reg.encoding();
+      for (FloatRegister a : avoid) {
+        taken |= a.encoding() == r.encoding();
+      }
+      if (!taken) {
+        regs_[count_++] = r;
+      }
+    }
+    MOZ_RELEASE_ASSERT(count_ == count);
+    masm_.reserveStack(16 * count_);
+    for (size_t i = 0; i < count_; i++) {
+      masm_.storeUnalignedSimd128(
+          regs_[i], Address(masm_.getStackPointer(), 16 * i));
+    }
+  }
+  ~X86EmuTemps() {
+    for (size_t i = 0; i < count_; i++) {
+      masm_.loadUnalignedSimd128(Address(masm_.getStackPointer(), 16 * i),
+                                 regs_[i]);
+    }
+    masm_.freeStack(16 * count_);
+  }
+  FloatRegister operator[](size_t i) const { return regs_[i]; }
+};
+
+ARMFPRegister Lanes(FloatRegister r, bool isDouble) {
+  return isDouble ? SimdReg(r).V2D() : SimdReg(r).V4S();
+}
+
+}  // namespace
+
+void MacroAssemblerCompat::x86FloatArith(X86FloatOp op,
+                                         const ARMFPRegister& dest,
+                                         const ARMFPRegister& lhs,
+                                         const ARMFPRegister& rhs) {
+  auto emit = [&] {
+    switch (op) {
+      case X86FloatOp::Add:
+        Fadd(dest, lhs, rhs);
+        break;
+      case X86FloatOp::Sub:
+        Fsub(dest, lhs, rhs);
+        break;
+      case X86FloatOp::Mul:
+        Fmul(dest, lhs, rhs);
+        break;
+      case X86FloatOp::Div:
+        Fdiv(dest, lhs, rhs);
+        break;
+      case X86FloatOp::Sqrt:
+        Fsqrt(dest, lhs);
+        break;
+    }
+  };
+  if (!EmulateX86) {
+    emit();
+    return;
+  }
+  // A NaN operand propagates the same on both CPUs. A NaN made from non-NaN
+  // operands is ARM's positive default NaN, which is x86's negated. The
+  // operation leaves the flags alone, and `dest` may alias an operand.
+  Label done;
+  Fcmp(lhs, rhs);
+  emit();
+  B(&done, Assembler::Overflow);
+  Fcmp(dest, dest);
+  B(&done, Assembler::NoOverflow);
+  Fneg(dest, dest);
+  bind(&done);
+}
+
+void MacroAssemblerCompat::x86MinMaxSimd128(bool isMax, bool isDouble,
+                                            FloatRegister lhs,
+                                            FloatRegister rhs,
+                                            FloatRegister dest) {
+  // minps and maxps: lhs < rhs ? lhs : rhs (or >), so a NaN in either operand
+  // and the second of two zeros give rhs as it is.
+  ScratchSimd128Scope scratch(asMasm());
+  if (isMax) {
+    Fcmgt(Lanes(scratch, isDouble), Lanes(lhs, isDouble), Lanes(rhs, isDouble));
+  } else {
+    Fcmgt(Lanes(scratch, isDouble), Lanes(rhs, isDouble), Lanes(lhs, isDouble));
+  }
+  Bsl(Simd16B(scratch), Simd16B(lhs), Simd16B(rhs));
+  Mov(SimdReg(dest), SimdReg(scratch));
+}
+
+void MacroAssemblerCompat::x86FmaSimd128(bool negate, bool isDouble,
+                                         FloatRegister src1,
+                                         FloatRegister src2,
+                                         FloatRegister srcDest) {
+  // vfmadd231 and vfnmadd231 round as FMLA and FMLS do. They differ in NaNs:
+  // a NaN operand gives the first NaN of srcDest, src1, src2, quieted and never
+  // negated, and an invalid operation gives the negative default NaN.
+  X86EmuTemps t(asMasm(), 4, {src1, src2, srcDest});
+  FloatRegister result = t[0], pick = t[1], mask = t[2], ordered = t[3];
+  ScratchSimd128Scope scratch(asMasm());
+  auto lanes = [&](FloatRegister r) { return Lanes(r, isDouble); };
+  auto loadQuietBit = [&] {
+    if (isDouble) {
+      asMasm().loadConstantSimd128(
+          SimdConstant::SplatX2(int64_t(0x0008000000000000)), scratch);
+    } else {
+      Movi(Simd4S(scratch), 0x40, vixl::LSL, 16);
+    }
+  };
+
+  Mov(SimdReg(result), SimdReg(srcDest));
+  if (negate) {
+    Fmls(lanes(result), lanes(src1), lanes(src2));
+  } else {
+    Fmla(lanes(result), lanes(src1), lanes(src2));
+  }
+  Fcmeq(lanes(mask), lanes(result), lanes(result));
+  Mvn(Simd16B(mask), Simd16B(mask));
+  Shl(lanes(mask), lanes(mask), isDouble ? 63 : 31);
+  Eor(Simd16B(result), Simd16B(result), Simd16B(mask));
+
+  loadQuietBit();
+  Orr(Simd16B(pick), Simd16B(src2), Simd16B(scratch));
+  Fcmeq(lanes(ordered), lanes(src2), lanes(src2));
+  Fcmeq(lanes(mask), lanes(src1), lanes(src1));
+  And(Simd16B(ordered), Simd16B(ordered), Simd16B(mask));
+  Orr(Simd16B(scratch), Simd16B(src1), Simd16B(scratch));
+  Bif(Simd16B(pick), Simd16B(scratch), Simd16B(mask));
+  Fcmeq(lanes(mask), lanes(srcDest), lanes(srcDest));
+  And(Simd16B(ordered), Simd16B(ordered), Simd16B(mask));
+  loadQuietBit();
+  Orr(Simd16B(scratch), Simd16B(srcDest), Simd16B(scratch));
+  Bif(Simd16B(pick), Simd16B(scratch), Simd16B(mask));
+  Bif(Simd16B(result), Simd16B(pick), Simd16B(ordered));
+  Mov(SimdReg(srcDest), SimdReg(result));
+}
+
+void MacroAssemblerCompat::x86LaneSelectSimd128(FloatRegister mask,
+                                                FloatRegister lhs,
+                                                FloatRegister rhs,
+                                                FloatRegister dest) {
+  // pblendvb: lhs where the mask byte's top bit is set, else rhs.
+  ScratchSimd128Scope scratch(asMasm());
+  Cmlt(Simd16B(scratch), Simd16B(mask), 0);
+  Bsl(Simd16B(scratch), Simd16B(lhs), Simd16B(rhs));
+  Mov(SimdReg(dest), SimdReg(scratch));
+}
