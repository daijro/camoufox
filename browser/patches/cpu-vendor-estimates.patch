+void MacroAssemblerCompat::x86SwizzleInt8x16(FloatRegister lhs,
+                                             FloatRegister rhs,
+                                             FloatRegister dest) {
+  // pshufb: an index with its top bit set gives 0, else its low four bits
+  // pick the byte.
+  ScratchSimd128Scope scratch(asMasm());
+  Movi(Simd16B(scratch), 0x8f);
+  And(Simd16B(scratch), Simd16B(rhs), Simd16B(scratch));
+  Tbl(Simd16B(dest), Simd16B(lhs), Simd16B(scratch));
+}
+
+void MacroAssemblerCompat::x86Q15MulrInt16x8(FloatRegister lhs,
+                                             FloatRegister rhs,
+                                             FloatRegister dest) {
+  // pmulhrsw wraps -32768 * -32768 to -32768 where SQRDMULH saturates it to
+  // 32767; every other product is the same.
+  X86EmuTemps t(asMasm(), 1, {lhs, rhs, dest});
+  ScratchSimd128Scope scratch(asMasm());
+  Movi(Simd8H(scratch), 0x80, vixl::LSL, 8);
+  Cmeq(Simd8H(t[0]), Simd8H(lhs), Simd8H(scratch));
+  Cmeq(Simd8H(scratch), Simd8H(rhs), Simd8H(scratch));
+  And(Simd16B(t[0]), Simd16B(t[0]), Simd16B(scratch));
+  Sqrdmulh(Simd8H(dest), Simd8H(lhs), Simd8H(rhs));
+  Eor(Simd16B(dest), Simd16B(dest), Simd16B(t[0]));
+}
+
+void MacroAssemblerCompat::x86DotInt8x16Int7x16(FloatRegister lhs,
+                                                FloatRegister rhs,
+                                                FloatRegister dest, bool add) {
+  // pmaddubsw: the unsigned bytes of rhs times the signed bytes of lhs, each
+  // pair summed with signed saturation. pmaddwd by ones then widens the pairs
+  // without saturating.
+  X86EmuTemps t(asMasm(), 2, {lhs, rhs, dest});
+  ScratchSimd128Scope scratch(asMasm());
+  Uxtl(Simd8H(t[0]), Simd8B(rhs));
+  Sxtl(Simd8H(scratch), Simd8B(lhs));
+  Mul(Simd8H(t[0]), Simd8H(t[0]), Simd8H(scratch));
+  Uxtl2(Simd8H(t[1]), Simd16B(rhs));
+  Sxtl2(Simd8H(scratch), Simd16B(lhs));
+  Mul(Simd8H(t[1]), Simd8H(t[1]), Simd8H(scratch));
+  Uzp1(Simd8H(scratch), Simd8H(t[0]), Simd8H(t[1]));
+  Uzp2(Simd8H(t[0]), Simd8H(t[0]), Simd8H(t[1]));
+  if (!add) {
+    Sqadd(Simd8H(dest), Simd8H(scratch), Simd8H(t[0]));
+    return;
+  }
+  Sqadd(Simd8H(t[0]), Simd8H(scratch), Simd8H(t[0]));
+  Saddlp(Simd4S(t[0]), Simd8H(t[0]));
+  Add(Simd4S(dest), Simd4S(dest), Simd4S(t[0]));
+}
