+// ===============================================================
+// ARM64 emulation of wasm relaxed SIMD (general.cpu_identity=3).
+//
+// Relaxed SIMD lets each CPU pick its own result for out-of-range swizzle
+// indices, NaN and signed-zero min/max, overflowing truncation, lane select,
+// the i7 dot product and the NaN of a fused multiply-add, so the results tell
+// x86 from ARM. When EmulateArm64 is set, these lower to the result an ARMv8
+// core gives (the instruction SpiderMonkey's arm64 backend emits, at the
+// default FPCR) instead of the x86 one. Only the relaxed ops take this path;
+// the deterministic SIMD ops are unchanged.
+
+#ifdef JS_CODEGEN_X64
+namespace {
+
+// Up to kMax SIMD registers borrowed for the length of one operation: they
+// are saved below the stack pointer's current frame and restored on scope
+// exit. The scratch register and the registers in `avoid` are never taken.
+class ArmEmuTemps {
+  static constexpr size_t kMax = 10;
+  MacroAssembler& masm_;
+  FloatRegister regs_[kMax];
+  size_t count_ = 0;
+
+ public:
+  ArmEmuTemps(MacroAssembler& masm, size_t count,
+              std::initializer_list<FloatRegister> avoid)
+      : masm_(masm) {
+    MOZ_RELEASE_ASSERT(count <= kMax);
+    for (uint32_t code = 0; count_ < count && code < FloatRegisters::TotalPhys;
+         code++) {
+      FloatRegister r(FloatRegisters::Encoding(code), FloatRegisters::Simd128);
+      bool taken = r.encoding() == ScratchSimd128Reg.encoding();
+      for (FloatRegister a : avoid) {
+        taken |= a.encoding() == r.encoding();
+      }
+      if (!taken) {
+        regs_[count_++] = r;
+      }
+    }
+    MOZ_RELEASE_ASSERT(count_ == count);
+    masm_.reserveStack(16 * count_);
+    for (size_t i = 0; i < count_; i++) {
+      masm_.vmovdqu(regs_[i], Operand(Address(StackPointer, 16 * i)));
+    }
+  }
+  ~ArmEmuTemps() {
+    for (size_t i = 0; i < count_; i++) {
+      masm_.vmovdqu(Operand(Address(StackPointer, 16 * i)), regs_[i]);
+    }
+    masm_.freeStack(16 * count_);
+  }
+  FloatRegister operator[](size_t i) const { return regs_[i]; }
+};
+
+// The two-operand forms below (dest == first source) encode the same on SSE
+// and AVX hosts.
+struct ArmEmuOps {
+  MacroAssembler& m;
+  bool dbl;
+
+  void mov(FloatRegister src, FloatRegister dest) {
+    if (src != dest) {
+      m.vmovdqa(src, dest);
+    }
+  }
+  void and_(FloatRegister d, FloatRegister s) { m.vpand(Operand(s), d, d); }
+  void andn(FloatRegister d, FloatRegister s) {  // d = ~d & s
+    m.vpandn(Operand(s), d, d);
+  }
+  void or_(FloatRegister d, FloatRegister s) { m.vpor(Operand(s), d, d); }
+  void xor_(FloatRegister d, FloatRegister s) { m.vpxor(Operand(s), d, d); }
+  void eq(FloatRegister d, FloatRegister s) {
+    if (dbl) {
+      m.vpcmpeqq(Operand(s), d, d);
+    } else {
+      m.vpcmpeqd(Operand(s), d, d);
+    }
+  }
+  // d = all ones in the lanes where d or s is NaN.
+  void unord(FloatRegister d, FloatRegister s) {
+    if (dbl) {
+      m.vcmpunordpd(Operand(s), d, d);
+    } else {
+      m.vcmpunordps(Operand(s), d, d);
+    }
+  }
+  void splat(uint64_t bits64, uint32_t bits32, FloatRegister d) {
+    m.loadConstantSimd128(dbl ? SimdConstant::SplatX2(int64_t(bits64))
+                              : SimdConstant::SplatX4(int32_t(bits32)),
+                          d);
+  }
+  void quietBit(FloatRegister d) { splat(0x0008000000000000, 0x00400000, d); }
+  void signBit(FloatRegister d) { splat(0x8000000000000000, 0x80000000, d); }
+  void absMask(FloatRegister d) { splat(0x7fffffffffffffff, 0x7fffffff, d); }
+  void infBits(FloatRegister d) { splat(0x7ff0000000000000, 0x7f800000, d); }
+  // ARM's default NaN (FPCR.DN=0 still uses it for invalid operations): the
+  // sign is clear, where x86's is set.
+  void defaultNaN(FloatRegister d) {
+    splat(0x7ff8000000000000, 0x7fc00000, d);
+  }
+  // v = m ? x : v, bitwise. Clobbers t.
+  void blend(FloatRegister v, FloatRegister x, FloatRegister mask,
+             FloatRegister t) {
+    mov(mask, t);
+    andn(t, v);  // ~mask & v
+    mov(x, v);
+    and_(v, mask);
+    or_(v, t);
+  }
+  // d = lanes of x that are a signalling NaN. Clobbers t and k.
+  void snan(FloatRegister x, FloatRegister d, FloatRegister t,
+            FloatRegister k) {
+    mov(x, d);
+    quietBit(k);
+    and_(d, k);
+    eq(d, k);  // quiet bit set
+    mov(x, t);
+    unord(t, x);
+    andn(d, t);  // NaN without the quiet bit
+  }
+};
