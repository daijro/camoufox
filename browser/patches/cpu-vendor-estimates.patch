@@ -6,16 +6,30 @@
 
 #include "mozilla/SSE.h"
 #include "mozilla/arm.h"
+#include "mozilla/StaticPrefs_general.h"
+
+// Camoufox: general.cpu_identity. Firefox for aarch64 builds this resampler
+// without SIMD (the NEON file is only built for 32-bit ARM), so an emulated
+// ARM64 CPU takes the plain C paths, and an emulated Intel or AMD CPU on an
+// ARM64 host takes the SSE ones (built against x86emu).
+static bool EmulatesArm64() {
+  return mozilla::StaticPrefs::general_cpu_identity() == 3;
+}
+
+static bool EmulatesX86() {
+  uint32_t identity = mozilla::StaticPrefs::general_cpu_identity();
+  return identity == 1 || identity == 2;
+}
 
 #ifdef USE_SSE2
 int moz_speex_have_double_simd() {
-  return mozilla::supports_sse2() ? 1 : 0;
+  return (mozilla::supports_sse2() && !EmulatesArm64()) || EmulatesX86();
 }
 #endif
 
 #ifdef USE_SSE
 int moz_speex_have_single_simd() {
-  return mozilla::supports_sse() ? 1 : 0;
+  return (mozilla::supports_sse() && !EmulatesArm64()) || EmulatesX86();
 }
 #endif
 
