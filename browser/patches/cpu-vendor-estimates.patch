+void MacroAssembler::emulateArmNaN(FloatRegister value) {
+  // See ArmNaN (JitOptions.h). Clearing the sign of a NaN leaves it a NaN, so
+  // the register may stay live.
+  if (!EmulateArm64) {
+    return;
+  }
+  Label done;
+  if (value.isDouble()) {
+    branchDouble(DoubleOrdered, value, value, &done);
+    absDouble(value, value);
+  } else {
+    branchFloat(DoubleOrdered, value, value, &done);
+    absFloat32(value, value);
+  }
+  bind(&done);
+}
