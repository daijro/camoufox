diff --git a/modules/libpref/init/StaticPrefList.yaml b/modules/libpref/init/StaticPrefList.yaml
--- a/modules/libpref/init/StaticPrefList.yaml
+++ b/modules/libpref/init/StaticPrefList.yaml
@@ -8334,6 +8334,17 @@
   value: false
   mirror: once
 
+# The x86 CPU vendor whose RCPPS/RSQRTPS estimates Skia's raster pipeline and
+# libopus's encoder reproduce: 0 the CPU it runs on, 1 Intel, 2 AMD. The two
+# vendors' estimate instructions give different bits, which reach canvas
+# readback through blend modes, perspective and matrix inversion, and encoded
+# Opus through the PVQ search (SkCpuEstimates.h, opus_cpu_estimates.h). A
+# value naming the CPU it runs on changes nothing. The name predates Opus.
+- name: gfx.skia.cpu_vendor_estimates
+  type: RelaxedAtomicUint32
+  value: 0
+  mirror: always
+
 # Log severe performance warnings to the error console and profiles.
 # This should be use to quickly find which slow paths are used by test cases.
 - name: gfx.perf-warnings.enabled
