Camoufox: the popup blocker stays on, and the driver gets its own door.

Firefox blocks window.open() that is not called while handling user input
(dom.disable_open_during_load, default true). Playwright and geckodriver both
turn that off, and a page reads the difference in one line with no permission
and nothing to wait for:

    const w = window.open('', '_blank');   // null on stock Firefox
    if (w) { w.close(); /* not a stock browser */ }

Camoufox used to ship the blocker off for one reason: with it on,
page.evaluate(() => window.open(...)) returns null, which breaks ~35 tests of
the upstream Playwright suite and every caller who scripts a popup.

So lift the blocker for the driver instead of for everyone.
nsIDocShell.driverPopupsAllowed makes this docShell's window.open behave as if
it were handling user input, and juggler sets it only while an explicit
Runtime.evaluate / Runtime.callFunction is on the stack (see
additions/juggler/content/Runtime.js::withDriverPopups). Unlike upstream's
nsIDOMWindowUtils.setHandlingUserInput(), it grants NO user-gesture activation:
navigator.userActivation, getAutoplayPolicy() and everything else a page can
read are untouched, which is the leak that made evaluate() stop doing that in
the first place.

KNOWN LIMIT, measured 2026-09-18: the flag is a content-process docShell member,
so it only reaches decisions the content process makes. window.open() is one of
them (nsGlobalWindowOuter::OpenInternal runs in content and consults
BrowsingContext::IsPopupAllowed there). A <a target=_blank> click is NOT: the
retargeting happens in the parent, which sees only the pref, so
page.eval_on_selector("a", "a => a.click()") on such a link no longer opens a
popup -- exactly as on stock, where a scripted click carries no activation
either. Reaching that case would mean making this a synced BrowsingContext field
instead of a docShell member. page.click() is unaffected: it synthesizes a real
click, which grants a real activation.

Guards: tests/patches/popup-blocker-parity.py (both directions, plus that no
user activation is granted), sundial ls-popup-blocker (a gesture-less
window.open must be blocked), and the upstream suite's popup tests
(page.evaluate(window.open) must keep working).

diff --git a/docshell/base/nsIDocShell.idl b/docshell/base/nsIDocShell.idl
--- a/docshell/base/nsIDocShell.idl
+++ b/docshell/base/nsIDocShell.idl
@@ -703,6 +703,23 @@
 
   attribute boolean disallowBFCache;
 
+  /**
+   * Camoufox: while true, window.open() from this docShell is not subject to
+   * the popup blocker, exactly as if it had been called while handling user
+   * input -- and ONLY that: no user-gesture activation is granted, so
+   * navigator.userActivation, the autoplay policy and everything else a page
+   * can read are untouched.
+   *
+   * Juggler sets it around the SYNCHRONOUS part of an explicit
+   * Runtime.evaluate / Runtime.callFunction, so page.evaluate(() =>
+   * window.open(...)) keeps working while dom.disable_open_during_load stays at
+   * Firefox's default. Turning the blocker off globally instead is a one-bit
+   * tell any page can read: a gesture-less window.open() returns null on stock
+   * Firefox. Holding it across an async evaluate would reopen that hole for as
+   * long as the evaluate runs, so it is not held there.
+   */
+  attribute boolean driverPopupsAllowed;
+
   attribute AString languageOverride;
 
   boolean overrideTimezone(in AString timezoneId);
diff --git a/docshell/base/nsDocShell.h b/docshell/base/nsDocShell.h
--- a/docshell/base/nsDocShell.h
+++ b/docshell/base/nsDocShell.h
@@ -404,6 +404,9 @@
 
   bool ShouldOverrideHasFocus() const;
 
+  // Camoufox: see nsIDocShell::driverPopupsAllowed.
+  bool DriverPopupsAllowed() const;
+
   bool IsBypassCSPEnabled();
 
   RefPtr<nsGeolocationService> GetGeolocationServiceOverride();
@@ -1316,6 +1319,7 @@
   bool mBypassCSPEnabled : 1;
   bool mForceActiveState : 1;
   bool mDisallowBFCache : 1;
+  bool mDriverPopupsAllowed : 1;
   nsString mLanguageOverride;
   RefPtr<nsGeolocationService> mGeolocationServiceOverride;
   ReducedMotionOverride mReducedMotionOverride;
diff --git a/docshell/base/nsDocShell.cpp b/docshell/base/nsDocShell.cpp
--- a/docshell/base/nsDocShell.cpp
+++ b/docshell/base/nsDocShell.cpp
@@ -368,6 +368,7 @@
       mBypassCSPEnabled(false),
       mForceActiveState(false),
       mDisallowBFCache(false),
+      mDriverPopupsAllowed(false),
       mReducedMotionOverride(REDUCED_MOTION_OVERRIDE_NONE),
       mForcedColorsOverride(FORCED_COLORS_OVERRIDE_NO_OVERRIDE),
       mContrastOverride(CONTRAST_OVERRIDE_NONE),
@@ -3024,6 +3025,21 @@
   return NS_OK;
 }
 
+NS_IMETHODIMP
+nsDocShell::GetDriverPopupsAllowed(bool* aEnabled) {
+  MOZ_ASSERT(aEnabled);
+  *aEnabled = mDriverPopupsAllowed;
+  return NS_OK;
+}
+
+NS_IMETHODIMP
+nsDocShell::SetDriverPopupsAllowed(bool aEnabled) {
+  mDriverPopupsAllowed = aEnabled;
+  return NS_OK;
+}
+
+bool nsDocShell::DriverPopupsAllowed() const { return mDriverPopupsAllowed; }
+
 bool nsDocShell::IsBypassCSPEnabled() {
   return GetRootDocShell()->mBypassCSPEnabled;
 }
diff --git a/docshell/base/BrowsingContext.cpp b/docshell/base/BrowsingContext.cpp
--- a/docshell/base/BrowsingContext.cpp
+++ b/docshell/base/BrowsingContext.cpp
@@ -4376,6 +4376,18 @@
     if (context->CanShowPopup()) {
       return true;
     }
+    // Camoufox: an explicit driver evaluate opens popups the way handling user
+    // input does, without granting the document a user-gesture activation.
+    // See nsIDocShell::driverPopupsAllowed; the flag is only ever set around a
+    // juggler Runtime.evaluate / Runtime.callFunction, so page scripts never
+    // see it and the popup blocker stays at Firefox's default for them.
+    if (BrowsingContext* bc = context->GetBrowsingContext()) {
+      if (nsIDocShell* shell = bc->GetDocShell()) {
+        if (nsDocShell::Cast(shell)->DriverPopupsAllowed()) {
+          return true;
+        }
+      }
+    }
   }
 
   return false;
