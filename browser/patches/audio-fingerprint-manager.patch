+class AudioFingerprintManager {
+ public:
+  static void SetSeed(uint32_t aUserContextId, uint32_t aSeed);
+  // Whether the context's audio is noised at all; off wins over any seed.
+  static void SetNoise(uint32_t aUserContextId, bool aEnabled);
