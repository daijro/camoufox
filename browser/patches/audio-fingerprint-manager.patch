+// Camoufox: the window whose context's audio noise applies.
+static nsPIDOMWindowInner* OwnerWindow(AudioContext* aContext) {
+  nsIGlobalObject* global = aContext ? aContext->GetParentObject() : nullptr;
+  return global ? global->GetAsInnerWindow() : nullptr;
+}
+
+// Camoufox: the frequency data with the context's audio noise, as a copy.
+// mOutputBuffer is the smoothing state the next FFTAnalysis() blends into, so
+// noising it in place compounded the noise with every read.
+const float* AnalyserNode::NoisedOutput(AlignedTArray<float>& aScratch) const {
+  uint32_t seed =
+      AudioFingerprintManager::GetSeed(OwnerWindow(GetParentObject()));
+  if (!seed || !aScratch.SetLength(mOutputBuffer.Length(), fallible)) {
+    return mOutputBuffer.Elements();
+  }
+  PodCopy(aScratch.Elements(), mOutputBuffer.Elements(), mOutputBuffer.Length());
+  AudioFingerprintManager::ApplyTransformation(aScratch.Elements(),
+                                               aScratch.Length(), seed);
+  return aScratch.Elements();
+}
