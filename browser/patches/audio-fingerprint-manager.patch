+#include "AudioFingerprintManager.h"
+#include "nsTHashMap.h"  // Must come before RoverfoxStorageManager.h for template defs
+#include "nsHashKeys.h"  // For nsStringHashKey
+#include "RoverfoxStorageManager.h"
+#include "MaskConfig.hpp"
+#include <algorithm>
+
+namespace mozilla {
+namespace dom {
+
+/* static */ void
+AudioFingerprintManager::DisableFunction(uint32_t userContextId) {
+  RoverfoxStorageManager::MarkSetterUsed("audio", userContextId);
+}
+
+/* static */ void
+AudioFingerprintManager::SetSeed(uint32_t aUserContextId, uint32_t aSeed) {
+  nsString key;
+  key.AppendPrintf("audioFingerprintSeed_%u", aUserContextId);
+  RoverfoxStorageManager::PutUint(key, aSeed);
+  DisableFunction(aUserContextId);
+}
+
+/* static */ void
+AudioFingerprintManager::SetNoise(uint32_t aUserContextId, bool aEnabled) {
+  nsString key;
+  key.AppendPrintf("audioFingerprintNoise_%u", aUserContextId);
+  RoverfoxStorageManager::PutBool(key, aEnabled);
+  RoverfoxStorageManager::MarkSetterUsed("audioNoise", aUserContextId);
+}
+
+/* static */ uint32_t
+AudioFingerprintManager::GetSeed(uint32_t aUserContextId) {
+  // A context that turned its noise off renders stock audio, whatever seed the
+  // launch set: a seed of 0 cannot say this, since 0 means "no seed of its own".
+  nsString noiseKey;
+  noiseKey.AppendPrintf("audioFingerprintNoise_%u", aUserContextId);
+  bool noise = true;
+  if (RoverfoxStorageManager::GetBool(noiseKey, noise) && !noise) {
+    return 0;
+  }
+  nsString key;
+  key.AppendPrintf("audioFingerprintSeed_%u", aUserContextId);
+  uint32_t seed = 0;
+  if (RoverfoxStorageManager::GetUint(key, seed) && seed != 0) {
+    return seed;
+  }
+  // A context that set no seed of its own uses the launch-level one.
+  if (auto val = MaskConfig::GetUint32("audio:seed")) {
+    return val.value();
+  }
+  return 0;
+}
+
+/* static */ uint32_t
+AudioFingerprintManager::GetSeed(nsPIDOMWindowInner* aWindow) {
+  return GetSeed(RoverfoxStorageManager::UserContextId(aWindow));
+}
+
+/* static */ void
+AudioFingerprintManager::ApplyTransformation(float* data, uint32_t length, uint32_t seed) {
+  if (seed == 0 || length == 0 || !data) {
+    return;
+  }
+  // LCG for deterministic transformation - same seed always produces same result
+  // Uses 0.8% variance (range [0.996, 1.004]) with non-linear polynomial component
+  uint32_t state = seed;
+  for (uint32_t i = 0; i < length; ++i) {
+    state = (state * 1664525u + 1013904223u);
+    float normalized = static_cast<float>(state) / 4294967295.0f;
+    // Linear base: 0.8% variance
+    float base = 0.996f + normalized * 0.008f;
+    // Non-linear polynomial adjustment - makes reverse-engineering harder
+    float adjustment = (normalized * normalized - 0.5f) * 0.002f;
+    float multiplier = base + adjustment;
+    data[i] *= multiplier;
+  }
+}
+
+/* static */ bool
+AudioFingerprintManager::IsFunctionEnabledForWebIDL(JSContext* aCx, JSObject* aObj) {
+  return RoverfoxStorageManager::IsSetterOffered(aObj, "audio");
+}
+
+/* static */ bool
+AudioFingerprintManager::IsNoiseFunctionEnabledForWebIDL(JSContext* aCx, JSObject* aObj) {
+  return RoverfoxStorageManager::IsSetterOffered(aObj, "audioNoise");
+}
+
+}  // namespace dom
+}  // namespace mozilla
