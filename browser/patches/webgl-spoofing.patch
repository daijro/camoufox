+
+void nsGlobalWindowInner::SetWebGLVendor(const nsAString& vendor,
+                                          ErrorResult& aRv) {
+  uint32_t userContextId = 0;
+  if (BrowsingContext* bc = GetBrowsingContext()) {
+    userContextId = bc->OriginAttributesRef().mUserContextId;
+  }
+  WebGLParamsManager::SetVendor(userContextId, vendor);
+  if (userContextId != 0) {
+    WebGLParamsManager::SetVendor(0, vendor);
+  }
+  WebGLParamsManager::DisableVendorFunction(userContextId);
+  RoverfoxStorageManager::RemoveSetter("setWebGLVendor");
+}
+
+void nsGlobalWindowInner::SetWebGLRenderer(const nsAString& renderer,
+                                            ErrorResult& aRv) {
+  uint32_t userContextId = 0;
+  if (BrowsingContext* bc = GetBrowsingContext()) {
+    userContextId = bc->OriginAttributesRef().mUserContextId;
+  }
+  WebGLParamsManager::SetRenderer(userContextId, renderer);
+  if (userContextId != 0) {
+    WebGLParamsManager::SetRenderer(0, renderer);
+  }
+  WebGLParamsManager::DisableRendererFunction(userContextId);
+  RoverfoxStorageManager::RemoveSetter("setWebGLRenderer");
+}
