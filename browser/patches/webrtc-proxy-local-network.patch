     return(0);
   }
 
+/* Camoufox: loopback, link-local, RFC1918 and IPv6 unique-local addresses.
+   Carrier-grade NAT space (100.64/10) is not: it is the ISP's network. */
+int nr_transport_addr_is_local_network(const nr_transport_addr *addr)
+  {
+    if (nr_transport_addr_is_loopback(addr) || nr_transport_addr_is_link_local(addr))
+      return(1);
+    switch(addr->ip_version){
+      case NR_IPV4:
+        {
+          int range = nr_transport_addr_get_private_addr_range(addr);
+          return(range >= 1 && range <= 3);
+        }
+      case NR_IPV6:
+        /* RFC4193: fc00::/7 */
+        return((addr->u.addr6.sin6_addr.s6_addr[0] & 0xFE) == 0xFC);
+      default:
+        break;
+    }
+    return(0);
+  }
