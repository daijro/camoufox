+              byAutomationScript ? ComboboxSelectedOption(control) : nullptr) {
+        DispatchSelectOptionMouseEvent(option, u"mousedown"_ns, false);
+        DispatchSelectOptionMouseEvent(option, u"mouseup"_ns, false);
