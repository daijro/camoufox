+// True in Juggler's automation worlds, which are per-frame sandboxes holding an
+// ExpandedPrincipal over the document's own principal (_createIsolatedContext()
+// in additions/juggler/content/FrameTree.js). Playwright synthesises there the
+// events a native widget would have sent -- "input"/"change" for <select>, for
+// <input type=date|color|range>, for file pickers -- and Event.isTrusted would
+// otherwise separate every one of them from a real user's.
+//
+// Requiring the allowlist to be exactly the target document excludes
+// WebExtension content scripts, which are expanded principals too but also list
+// the extension. The caller is the scripted one, not the current realm: the
+// sandbox reaches Event through an Xray, so by here the wrapper has entered the
+// page's realm and a realm check would see the page principal.
+static bool IsAutomationWorldCaller(Document* aTargetDoc) {
+  JSContext* cx = nsContentUtils::GetCurrentJSContext();
+  if (!cx || !aTargetDoc) {
+    return false;
+  }
+  JSObject* callerGlobal = JS::GetScriptedCallerGlobal(cx);
+  if (!callerGlobal) {
+    return false;
+  }
+  nsIPrincipal* caller = nsContentUtils::ObjectPrincipal(callerGlobal);
+  if (!caller || !BasePrincipal::Cast(caller)->Is<ExpandedPrincipal>()) {
+    return false;
+  }
+  const nsTArray<nsCOMPtr<nsIPrincipal>>& allowList =
+      BasePrincipal::Cast(caller)->As<ExpandedPrincipal>()->AllowList();
+  return allowList.Length() == 1 &&
+         allowList[0]->Equals(aTargetDoc->NodePrincipal());
+}
