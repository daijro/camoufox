+  // commit path uses nsContentUtils::DispatchTrustedEvent, which is a system
+  // caller, so this excludes it -- it already emits what a user produces.
+  const bool byAutomationScript = aEvent.IsTrusted() &&
+                                  aCallerType != CallerType::System &&
+                                  HasScriptedCaller();
