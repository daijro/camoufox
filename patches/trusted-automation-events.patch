+// A mouse-driven <select> commit dispatches these on the chosen <option>, from
+// the parent process, around the input/change pair -- see the closedWithClickOn
+// branch of SelectChild.sys.mjs. Playwright mutates the DOM instead, so without
+// this the option-targeted events a real user produces are simply missing.
+// "click" is a PointerEvent there, the others MouseEvents; all bubble, are
+// cancelable and composed.
+static void DispatchSelectOptionMouseEvent(nsINode* aOption,
+                                           const nsAString& aType,
+                                           bool aAsPointerEvent) {
+  nsCOMPtr<nsPIDOMWindowInner> win = aOption->OwnerDoc()->GetInnerWindow();
+  RefPtr<Event> event;
+  if (aAsPointerEvent) {
+    PointerEventInit init;
+    init.mBubbles = true;
+    init.mCancelable = true;
+    init.mComposed = true;
+    init.mView = win ? nsGlobalWindowInner::Cast(win) : nullptr;
+    event = PointerEvent::Constructor(aOption, aType, init);
+  } else {
+    MouseEventInit init;
+    init.mBubbles = true;
+    init.mCancelable = true;
+    init.mComposed = true;
+    init.mView = win ? nsGlobalWindowInner::Cast(win) : nullptr;
+    event = MouseEvent::Constructor(aOption, aType, init);
+  }
+  event->SetTrusted(true);
+  aOption->DispatchEvent(*event, CallerType::System, IgnoreErrors());
+}
+
+// Whether script is what is dispatching, as opposed to Gecko's own event
+// handling. The native <select> commit path reaches this function too -- a
+// keyboard selection ends in nsContentUtils::DispatchTrustedEvent("change") --
+// and it already emits everything a user produces, so it must be left alone.
+// A keyboard commit also produces no option-targeted mouse events at all.
+static bool HasScriptedCaller() {
+  JSContext* cx = nsContentUtils::GetCurrentJSContext();
+  return cx && JS::GetScriptedCallerGlobal(cx);
+}
+
+// The <option> a commit would have been made on, or nullptr when this is not a
+// dropdown-style <select>.
+static nsINode* ComboboxSelectedOption(nsINode* aNode) {
+  auto* select = HTMLSelectElement::FromNode(aNode);
+  if (!select || !select->IsCombobox()) {
+    return nullptr;
+  }
+  const int32_t index = select->SelectedIndex();
+  return index < 0 ? nullptr : select->Item(index);
+}
