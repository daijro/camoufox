+#ifndef mozilla_dom_TimezoneManager_h
+#define mozilla_dom_TimezoneManager_h
+
+#include "nsString.h"
+
+struct JSContext;
+class JSObject;
+
+namespace mozilla {
+namespace dom {
+
+class TimezoneManager {
+ public:
+  static void SetTimezone(uint32_t userContextId, const nsAString& timezone);
+  static bool GetTimezone(uint32_t userContextId, nsAString& outTimezone);
+
+  // The zone JS::SetTimeZoneOverride last applied process-wide. A realm already
+  // reports it without a per-realm override, which is not free: setting one
+  // releases all JIT code in the runtime.
+  static void NoteProcessTimezone(const nsACString& timezone);
+  static bool IsProcessTimezone(const nsAString& timezone);
+
+  static void DisableFunction(uint32_t userContextId);
+  static bool IsFunctionEnabledForWebIDL(JSContext* aCx, JSObject* aObj);
+
+ private:
+  static nsString DisabledKeyForUserContext(uint32_t userContextId);
+};
+
+}  // namespace dom
+}  // namespace mozilla
+
+#endif  // mozilla_dom_TimezoneManager_h
